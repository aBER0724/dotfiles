#!/bin/bash
# dotfiles — manage symlinks between ~ and ~/dotfiles
# Usage:
#   dotfiles list                     list every managed entry (name → target)
#   dotfiles status [name...]         show link state (all, or only named)
#   dotfiles link [name...]           create links; backup+replace conflicts
#   dotfiles install [name...]        link (+ herdr plugins, pi hint for all)
set -euo pipefail

DOTFILES="${DOTFILES_DIR:-$HOME/dotfiles}"

# mise installs user-local shims and binaries; put them on PATH so the rest of
# this script (and spawned installers like herdr/install-plugins.sh) can see
# mise-managed tools even before the login shell picks them up.
export PATH="$HOME/.local/share/mise/shims:$HOME/.local/bin:$PATH"

# Each entry: "<name>|<repo-relative-path>|<target>"
# A target may start with `@app-support/` for per-OS application dirs;
# see resolve_target below.
# `name` is what you pass to status/link/install to act on that one dotfile.
LINK_TABLE=(
  "dotfiles-cli|bin/dotfiles|$HOME/.local/bin/dotfiles"
  "aerospace|aerospace/aerospace.toml|$HOME/.aerospace.toml"
  "zshrc|zsh/zshrc|$HOME/.zshrc"
  "zshenv|zsh/zshenv|$HOME/.zshenv"
  "zprofile|zsh/zprofile|$HOME/.zprofile"
  "shinit|zsh/shinit|$HOME/.shinit"
  "p10k|zsh/p10k.zsh|$HOME/.p10k.zsh"
  "nvim|nvim|$HOME/.config/nvim"
  "kaku|kaku|$HOME/.config/kaku"
  "niri|niri|$HOME/.config/niri"
  "hypr-blur|hypr/blur.lua|$HOME/.config/hypr/blur.lua"
  "waybar|waybar|$HOME/.config/waybar"
  "omarchy-shell|omarchy/shell.json|$HOME/.config/omarchy/shell.json"
  "omarchy-tray|omarchy/plugins/aber.tray|$HOME/.config/omarchy/plugins/aber.tray"
  "omarchy-indicators|omarchy/plugins/aber.indicators|$HOME/.config/omarchy/plugins/aber.indicators"
  "omarchy-kitty-reload|omarchy/hooks/theme-set.d/50-kitty-reload|$HOME/.config/omarchy/hooks/theme-set.d/50-kitty-reload"
  "omarchy-pi-theme|omarchy/hooks/theme-set.d/60-pi-theme|$HOME/.config/omarchy/hooks/theme-set.d/60-pi-theme"
  "omarchy-herdr-theme|omarchy/hooks/theme-set.d/70-herdr-theme|$HOME/.config/omarchy/hooks/theme-set.d/70-herdr-theme"
  "discord|discord/settings.json|$HOME/.config/discord/settings.json"
  "clavis|clavis/config|$HOME/.config/clavis"
  "nbshell-config|nbshell/config/config.json|$HOME/.config/nbshell/config.json"
  "nbshell-screensaver|nbshell/config/screensaver.txt|$HOME/.config/nbshell/screensaver.txt"
  "fcitx5-env|fcitx5/environment.d/fcitx.conf|$HOME/.config/environment.d/fcitx.conf"
  "fcitx5-conf|fcitx5/conf|$HOME/.config/fcitx5/conf"
  "fastfetch|fastfetch|$HOME/.config/fastfetch"
  "pi-settings|pi-agent/settings.json|$HOME/.pi/agent/settings.json"
  "pi-models|pi-agent/models.merged.json|$HOME/.pi/agent/models.json"
  "pi-extensions|pi-agent/extensions|$HOME/.pi/agent/extensions"
  "agent-skills|@home/.config/magpie/library/skills|$HOME/.agents/skills"
  "herdr|herdr/config.toml|$HOME/.config/herdr/config.toml"
  "herdr-lazygit-user|herdr/lazygit-user.yml|$HOME/.config/herdr/plugins/config/herdr-lazygit/lazygit-user.yml"
  "kitty-main|kitty/kitty.conf|$HOME/.config/kitty/kitty.conf"
  "kitty-linux|kitty/platform-linux.conf|$HOME/.config/kitty/platform-linux.conf"
  "kitty-macos|kitty/platform-macos.conf|$HOME/.config/kitty/platform-macos.conf"
  "kitty-tab-bar|kitty/tab_bar.py|$HOME/.config/kitty/tab_bar.py"
  "kitty-watcher|kitty/watcher.py|$HOME/.config/kitty/watcher.py"
  "kitty-resize-separator|kitty/resize_separator.py|$HOME/.config/kitty/resize_separator.py"
  "lazygit|lazygit/config.yml|@app-support/lazygit/config.yml"
  "clash-verge-script|clash-verge/verge-global-script.js|@app-support/io.github.clash-verge-rev.clash-verge-rev/profiles/Script.js"
  "mise-config|@mise-profile|$HOME/.config/mise/config.toml"
)

# Runtime software used by managed configs.
# Each entry: "<managed-name>|<command>|<darwin>|<arch>|<debian>".
# Each OS column holds a comma-separated preference list of "<backend>:<spec>"
# candidates — any backend can chain into any other (mise → brew, pacman →
# aur, ...). Each round consumes the head candidate, installs it through its
# backend, then verifies: `command -v` for binaries, `brew list --cask` for
# casks. Whatever is still missing advances to its next candidate; exhausted
# entries land in `missing_manual`. Use "-" for "no mapping":
#   mise:<tool>     install via mise (versions pinned in mise/<profile>.toml)
#   formula:<pkg>   Homebrew formula (macOS only)
#   cask:<pkg>      Homebrew cask (macOS only)
#   pacman:<pkgs>   Arch packages (omarchy/niri profiles)
#   aur:<pkgs>      Arch User Repository via yay/paru (auto-detected)
#   apt:<pkgs>      Debian/Ubuntu packages (server profile)
SOFTWARE_TABLE=(
  "aerospace|aerospace|cask:nikitabobko/tap/aerospace|-|-"
  "zshrc|zsh|formula:zsh|pacman:zsh|apt:zsh"
  "nvim|nvim|mise:neovim,formula:neovim|mise:neovim,pacman:neovim|mise:neovim,apt:neovim"
  "niri|niri|-|pacman:niri|-"
  "waybar|waybar|-|pacman:waybar|-"
  "discord|discord|-|pacman:discord,aur:discord|-"
  "nbshell-config|qs|-|pacman:quickshell|-"
  "fcitx5-conf|fcitx5|-|pacman:fcitx5-im fcitx5-rime fcitx5-configtool|-"
  "kitty-main|kitty|cask:kitty|pacman:kitty|-"
  "fastfetch|fastfetch|mise:fastfetch,formula:fastfetch|mise:fastfetch,pacman:fastfetch|mise:fastfetch"
  "pi-settings|node|mise:node,formula:node|mise:node,pacman:nodejs|mise:node,apt:nodejs"
  "pi-settings|pi|mise:npm:@earendil-works/pi-coding-agent|mise:npm:@earendil-works/pi-coding-agent|mise:npm:@earendil-works/pi-coding-agent"
  "pi|rtk|formula:rtk|-|-"
  # herdr ships Linux-only release assets, so the ubi spec fails on macOS and
  # falls through to the formula — the prefer-mise fallback chain in action.
  "herdr|herdr|mise:ubi:herdrdev/herdr,formula:herdr|mise:ubi:herdrdev/herdr|mise:ubi:herdrdev/herdr"
  "herdr|go|mise:go,formula:go|mise:go,pacman:go|mise:go,apt:golang-go"
  "herdr|tmux|mise:tmux,formula:tmux|mise:tmux,pacman:tmux|mise:tmux,apt:tmux"
  "herdr|cargo|mise:rust,formula:rust|mise:rust,pacman:rust|mise:rust,apt:rustc cargo"
  "herdr|yazi|mise:yazi,formula:yazi|mise:yazi,pacman:yazi|mise:yazi"
  "herdr|herdr-scratch|cask:macintacos/tap/herdr-scratch|-|-"
  # macOS takes the tap cask here; Linux installs through the upstream
  # installer in run_sheprd (no repository package exists for it).
  "sheprd|sheprd|cask:sheprd-labs/tap/sheprd|-|-"
  "lazygit|lazygit|mise:lazygit,formula:lazygit|mise:lazygit,pacman:lazygit|mise:lazygit"
  # mole is a shell-script project — GitHub releases ship only helper Go
  # binaries (analyze/status), no `mole` asset, so mise has nothing to grab.
  "mole|mole|formula:mole|-|-"
)

# Group aliases: "<alias>|<space-separated names>". Passing the alias to
# status/link/install expands to all members, e.g. `dotfiles link pi`.
GROUP_TABLE=(
  "pi|pi-settings pi-models pi-extensions agent-skills"
  "zsh|zshrc zshenv zprofile shinit p10k"
  "kitty|kitty-main kitty-linux kitty-macos kitty-tab-bar kitty-watcher kitty-resize-separator"
  "herdr|herdr herdr-lazygit-user"
  "fcitx|fcitx5-env fcitx5-conf"
  "nbshell|nbshell-config nbshell-screensaver"
  "omarchy|omarchy-shell omarchy-tray omarchy-indicators omarchy-kitty-reload omarchy-pi-theme omarchy-herdr-theme"
  "wm|niri nbshell-config nbshell-screensaver fcitx5-env fcitx5-conf"
  "mise|mise-config"
)

# Setup is split by operating system and, on Linux, by environment profile.
# `server` is safe for headless Ubuntu/Debian hosts; `omarchy` is the default
# Arch profile targeting stock Omarchy (Hyprland/uwsm); `niri` is the custom
# Niri + nbshell stack. Auto-detect picks omarchy on Arch, server on Debian.
PRESET_TABLE=(
  "macos|dotfiles-cli mise zsh nvim fastfetch pi herdr aerospace kitty lazygit mole sheprd"
  "linux-server|dotfiles-cli mise zsh nvim fastfetch pi herdr lazygit"
  "linux-omarchy|dotfiles-cli mise zsh nvim fastfetch pi herdr fcitx kitty lazygit omarchy hypr-blur sheprd"
  "linux-niri|dotfiles-cli mise zsh nvim fastfetch pi herdr niri nbshell kitty fcitx lazygit sheprd"
)

# Expand aliases in "$*" to concrete names (set -u + empty string is fine here).
expand_groups() {
  local w a members out
  out=""
  for w in $1; do
    members=""
    for a in "${GROUP_TABLE[@]}"; do
      if [ "${a%%|*}" = "$w" ]; then members="${a#*|}"; break; fi
    done
    if [ -n "$members" ]; then out="$out $members"; else out="$out $w"; fi
  done
  echo "$out"
}

# Resolve per-OS application support directories. A target written as
# `@app-support/<rest>` means `~/Library/Application Support/<rest>` on macOS
# and `~/.config/<rest>` on Linux (lazygit and similar apps use these paths).
resolve_target() {
  local target="$1" rest
  case "$target" in
    "@app-support/"*)
      rest="${target#@app-support/}"
      if [ "$(host_uname)" = "Darwin" ]; then
        printf '%s\n' "$HOME/Library/Application Support/$rest"
      else
        printf '%s\n' "$HOME/.config/$rest"
      fi
      ;;
    *) printf '%s\n' "$target" ;;
  esac
}

host_uname() {
  if [ -n "${DOTFILES_UNAME:-}" ]; then
    printf '%s\n' "$DOTFILES_UNAME"
  else
    uname -s
  fi
}

linux_distro() {
  local os_release="${DOTFILES_OS_RELEASE:-/etc/os-release}" id="" id_like=""
  [ "$(host_uname)" = "Linux" ] || return 1
  [ -r "$os_release" ] || { echo unknown; return 0; }
  id="$(sed -n 's/^ID=//p' "$os_release" | head -n 1 | tr -d '\"')"
  id_like="$(sed -n 's/^ID_LIKE=//p' "$os_release" | head -n 1 | tr -d '\"')"
  case " $id $id_like " in
    *" arch "*) echo arch ;;
    *" ubuntu "*|*" debian "*) echo debian ;;
    *) echo unknown ;;
  esac
}

detect_linux_profile() {
  case "$(linux_distro)" in
    arch) echo omarchy ;;
    debian) echo server ;;
    *)
      echo "dotfiles: unsupported Linux distribution; supported environments: omarchy (Arch) and server (Ubuntu/Debian)" >&2
      return 1
      ;;
  esac
}

# Which mise toolchain file backs the `mise-config` link entry and `mise
# install` runs. Override with DOTFILES_MISE_PROFILE for testing.
mise_profile() {
  if [ -n "${DOTFILES_MISE_PROFILE:-}" ]; then
    printf '%s\n' "$DOTFILES_MISE_PROFILE"
    return
  fi
  if [ "$(host_uname)" = "Darwin" ]; then
    echo macos
  elif [ "$(host_uname)" = "Linux" ]; then
    case "$(linux_distro)" in
      arch) echo linux-desktop ;;
      *)    echo linux-server ;;
    esac
  else
    echo macos
  fi
}

detect_system() {
  if [ "$(host_uname)" = "Darwin" ]; then
    echo macos
  elif [ "$(host_uname)" = "Linux" ]; then
    echo linux
  else
    echo "dotfiles: unsupported system; supported systems: macos linux" >&2
    return 1
  fi
}

validate_system() {
  case "$1" in
    macos)
      [ "$(host_uname)" = "Darwin" ] || {
        echo "dotfiles: setup macos requires macOS" >&2
        return 1
      }
      ;;
    linux)
      [ "$(host_uname)" = "Linux" ] || {
        echo "dotfiles: setup linux requires Linux" >&2
        return 1
      }
      ;;
    *)
      echo "dotfiles: unknown setup system '$1' (supported: auto macos linux)" >&2
      return 1
      ;;
  esac
}

validate_linux_profile() {
  local profile="$1" distro
  distro="$(linux_distro)"
  case "$profile" in
    server)
      [ "$distro" = debian ] || {
        echo "dotfiles: Linux profile 'server' requires Ubuntu, Debian, or a derivative" >&2
        return 1
      }
      command -v apt-get >/dev/null 2>&1 || {
        echo "dotfiles: Linux profile 'server' requires apt-get" >&2
        return 1
      }
      ;;
    omarchy|niri)
      [ "$distro" = arch ] || {
        echo "dotfiles: Linux profile '$profile' requires Arch Linux or an Arch derivative" >&2
        return 1
      }
      ;;
    *)
      echo "dotfiles: unknown Linux profile '$profile' (supported: auto server omarchy niri)" >&2
      return 1
      ;;
  esac
}

preset_entries() {
  local preset="$1" row
  for row in "${PRESET_TABLE[@]}"; do
    if [ "${row%%|*}" = "$preset" ]; then
      expand_groups "${row#*|}"
      return 0
    fi
  done
  return 1
}

# Defaults used by the /login-free key setup (see README)
PI_DEFAULT_PROVIDER="new-api"
HOMEBREW_INSTALL_URL="${DOTFILES_HOMEBREW_INSTALL_URL:-https://raw.githubusercontent.com/Homebrew/install/HEAD/install.sh}"
# sheprd ships no Linux repository package; its installer resolves the latest
# release, verifies it against the published SHA-256 and installs it with pacman.
SHEPRD_INSTALL_URL="${DOTFILES_SHEPRD_INSTALL_URL:-https://sheprd.org/install.sh}"
BOOTSTRAP_BASH="${DOTFILES_BASH_BIN:-/bin/bash}"
MISE_INSTALL_URL="${DOTFILES_MISE_INSTALL_URL:-https://mise.run}"
MACOS_BASE_PACKAGES="git"
ARCH_BASE_PACKAGES="git curl file procps-ng base-devel"
DEBIAN_BASE_PACKAGES="git curl file procps build-essential unzip xz-utils ca-certificates"
select_entries() {
  # "$*" joins args with spaces; empty when no names given (all entries).
  # Plain-string iteration keeps this bash 3.2-safe (empty arrays + set -u
  # are broken in old bash).
  local wanted="$*" entry name w ok nl
  wanted="$(expand_groups "$wanted")"
  nl=$'\n'
  SELECTED=""
  for entry in "${LINK_TABLE[@]}"; do
    name="${entry%%|*}"
    if [ -z "$wanted" ]; then
      SELECTED="${SELECTED}${entry}$nl"
    else
      for w in $wanted; do
        if [ "$w" = "$name" ]; then SELECTED="${SELECTED}${entry}$nl"; break; fi
      done
    fi
  done
  for w in $wanted; do
    ok=0
    for entry in "${LINK_TABLE[@]}"; do
      [ "$w" = "${entry%%|*}" ] && { ok=1; break; }
    done
    # A name can also come from SOFTWARE_TABLE alone: software that is installed
    # but owns no synced config file, like sheprd.
    if [ "$ok" = 0 ]; then
      for entry in "${SOFTWARE_TABLE[@]}"; do
        [ "$w" = "${entry%%|*}" ] && { ok=1; break; }
      done
    fi
    if [ "$ok" = 0 ]; then echo "dotfiles: unknown entry '$w' (see 'dotfiles list')" >&2; fi
  done
}

cmd_list() {
  local name src target
  printf "%-14s %-55s %s\n" "NAME" "SOURCE" "TARGET"
  for entry in "${LINK_TABLE[@]}"; do
    name="${entry%%|*}"
    src="${entry#*|}"
    target="$(resolve_target "${src#*|}")"
    src="$(resolve_source "${src%%|*}")"
    printf "%-14s %-55s %s\n" "$name" "$src" "$target"
  done
}

cmd_status() {
  local name src target state points oldifs
  printf "%-14s %-50s %s\n" "NAME" "TARGET" "STATE"
  oldifs="$IFS"; IFS=$'\n'
  for entry in $SELECTED; do
    IFS="$oldifs"
    name="${entry%%|*}"
    src="${entry#*|}"
    target="$(resolve_target "${src#*|}")"
    src="$(resolve_source "${src%%|*}")"
    if [ -L "$target" ]; then
      points="$(readlink "$target" 2>/dev/null || true)"
      if [ "$points" = "$src" ] && [ -e "$src" ]; then
        state="ok"
      elif [ "$points" = "$src" ]; then
        state="DANGLING (source missing)"
      else
        state="STALE → $points"
      fi
      printf "%-14s %-50s %s\n" "$name" "$target" "$state"
    elif [ -e "$target" ]; then
      printf "%-14s %-50s %s\n" "$name" "$target" "CONFLICT (real file)"
    else
      printf "%-14s %-50s %s\n" "$name" "$target" "missing"
    fi
  done
}

# Resolve link sources the same way resolve_target handles targets:
# `@home/<rest>` means $HOME/<rest> for sources that live outside the repo
# (e.g. the magpie skill library, which is machine-local).
resolve_source() {
  local src="$1"
  case "$src" in
    "@home/"*)       printf '%s\n' "$HOME/${src#@home/}" ;;
    "@mise-profile") printf '%s\n' "$DOTFILES/mise/$(mise_profile).toml" ;;
    *)               printf '%s\n' "$DOTFILES/$src" ;;
  esac
}

cmd_link() {
  local name src raw_src machine_local target backup_dir ts oldifs
  backup_dir="${DOTFILES_BACKUP_DIR:-$HOME/.dotfiles-backup-$(date +%Y%m%d-%H%M%S)}"
  ts=0
  if selected_has pi-models; then merge_pi_models; fi
  oldifs="$IFS"; IFS=$'\n'
  for entry in $SELECTED; do
    IFS="$oldifs"
    name="${entry%%|*}"
    src="${entry#*|}"
    target="$(resolve_target "${src#*|}")"
    raw_src="${src%%|*}"
    src="$(resolve_source "$raw_src")"
    machine_local=0
    case "$raw_src" in
      "@home/"*) machine_local=1 ;;
    esac
    # A machine-local source this machine does not have must not leave a dead
    # link behind: prune the dangling link, and never create a new one.
    if [ "$machine_local" = 1 ] && [ ! -e "$src" ]; then
      if [ -L "$target" ] && [ "$(readlink "$target" 2>/dev/null || true)" = "$src" ]; then
        rm -f "$target"
        echo "prune   $name (dangling → missing $src)"
      else
        echo "skip    $name (machine-local source missing: $src)"
      fi
      continue
    fi
    mkdir -p "$(dirname "$target")"
    if [ -L "$target" ]; then
      if [ "$(readlink "$target" 2>/dev/null || true)" = "$src" ]; then
        echo "ok      $name ($target)"
      else
        echo "repair  $name → $src"
        ln -sfn "$src" "$target"
      fi
      continue
    fi
    if [ -e "$target" ]; then
      if [ "$ts" = 0 ]; then
        mkdir -p "$backup_dir"
        echo "backups → $backup_dir"
        ts=1
      fi
      mv "$target" "$backup_dir/"
      echo "backup  $name ($target)"
    fi
    ln -sfn "$src" "$target"
    echo "link    $name ($target)"
  done
}
# Merge the public pi-agent/models.json with the machine-local, gitignored
# pi-agent/models.local.json into pi-agent/models.merged.json (the symlink
# target for ~/.pi/agent/models.json). Keeps local providers (magpie) off the
# repo while letting pi use one file.
merge_pi_models() {
  python3 - "$DOTFILES" <<'PY'
import json, sys, os
root = sys.argv[1]
base = json.load(open(f"{root}/pi-agent/models.json"))
local = f"{root}/pi-agent/models.local.json"
if os.path.exists(local):
    extra = json.load(open(local))
    base.setdefault("providers", {}).update(extra.get("providers", {}))
json.dump(base, open(f"{root}/pi-agent/models.merged.json", "w"), indent=2)
PY
}

selected_has() {
  local name="$1" entry oldifs="$IFS"
  IFS=$'\n'
  for entry in $SELECTED; do
    IFS="$oldifs"
    [ "${entry%%|*}" = "$name" ] && return 0
  done
  IFS="$oldifs"
  return 1
}
run_zsh_deps() {
  echo "== zsh deps =="
  if command -v git >/dev/null 2>&1; then
    bash "$DOTFILES/zsh/install-deps.sh"
  else
    echo "git not installed — skipped (required to clone zsh plugins)"
  fi
}

software_selected() {
  local owner="$1" wanted="$2" w
  for w in $wanted; do
    [ "$w" = "$owner" ] && return 0
  done
  return 1
}

read_package_file() {
  sed -e 's/[[:space:]]*#.*$//' -e '/^[[:space:]]*$/d' "$1" | tr '\n' ' '
}

# Link mise/<profile>.toml to ~/.config/mise/config.toml so plain
# `mise install` (and interactive use) resolves the pinned toolset.
# A conflicting existing config is moved aside like cmd_link does.
link_mise_config() {
  local src="$DOTFILES/mise/$(mise_profile).toml"
  local target="$HOME/.config/mise/config.toml" backup_dir
  [ -f "$src" ] || return 0
  mkdir -p "$(dirname "$target")"
  if [ -L "$target" ] && [ "$(readlink "$target" 2>/dev/null || true)" = "$src" ]; then
    return 0
  fi
  if [ -e "$target" ] || [ -L "$target" ]; then
    backup_dir="${DOTFILES_BACKUP_DIR:-$HOME/.dotfiles-backup-$(date +%Y%m%d-%H%M%S)}"
    mkdir -p "$backup_dir"
    mv "$target" "$backup_dir/"
    echo "backup  mise-config ($target)"
  fi
  ln -sfn "$src" "$target"
  echo "link    mise-config ($target)"
}

# mise is the user-level package manager for the CLI toolchain. The official
# installer needs no sudo, so it works on every profile including
# root-owned headless servers.
ensure_mise() {
  if ! command -v mise >/dev/null 2>&1; then
    command -v curl >/dev/null 2>&1 || {
      echo "dotfiles: curl is required to install mise" >&2
      return 1
    }
    echo "install mise from $MISE_INSTALL_URL"
    curl -fsSL "$MISE_INSTALL_URL" | sh
    command -v mise >/dev/null 2>&1 || {
      echo "dotfiles: mise bootstrap failed; check $MISE_INSTALL_URL" >&2
      return 1
    }
  fi
  link_mise_config
}

run_privileged() {
  if [ "$(id -u)" -eq 0 ]; then
    "$@"
  else
    command -v sudo >/dev/null 2>&1 || {
      echo "dotfiles: sudo is required to install native Linux packages" >&2
      return 1
    }
    sudo "$@"
  fi
}

install_arch_setup_packages() {
  command -v pacman >/dev/null 2>&1 || {
    echo "dotfiles: pacman is required for Arch desktop profiles (omarchy, niri)" >&2
    return 1
  }
  run_privileged pacman -S --needed $ARCH_BASE_PACKAGES
}
install_debian_setup_packages() {
  command -v apt-get >/dev/null 2>&1 || {
    echo "dotfiles: apt-get is required for the Linux server profile" >&2
    return 1
  }
  run_privileged apt-get update
  run_privileged apt-get install -y $DEBIAN_BASE_PACKAGES
}

# (Server CLI tools — node, neovim, yazi, fastfetch, herdr, go, rust — are
# now installed by mise per profile; see mise/*.toml and SOFTWARE_TABLE.)


run_software_install() {
  local wanted="$1" entry owner command_name darwin_spec arch_spec debian_spec
  local spec backend detail os_key candidates rest
  local brew_formulae="" brew_casks="" mise_specs=""
  local pacman_specs="" aur_specs="" apt_specs=""
  local missing_manual="" pending="" oldifs round

  case "$(host_uname)" in
    Darwin) os_key=darwin ;;
    Linux)
      case "$(linux_distro)" in
        arch)   os_key=arch ;;
        debian) os_key=debian ;;
        *)      os_key=unknown ;;
      esac
      ;;
    *) os_key=unknown ;;
  esac

  # Seed the worklist: one "command|cand,cand,..." record per line.
  oldifs="$IFS"; IFS=$'\n'
  for entry in "${SOFTWARE_TABLE[@]}"; do
    IFS="$oldifs"
    owner="${entry%%|*}"
    software_selected "$owner" "$wanted" || continue
    entry="${entry#*|}"; command_name="${entry%%|*}"
    entry="${entry#*|}"; darwin_spec="${entry%%|*}"
    entry="${entry#*|}"; arch_spec="${entry%%|*}"
    debian_spec="${entry#*|}"
    case "$os_key" in
      darwin) spec="$darwin_spec" ;;
      arch)   spec="$arch_spec" ;;
      debian) spec="$debian_spec" ;;
      *)      spec="-" ;;
    esac
    [ "$spec" = "-" ] && continue
    command -v "$command_name" >/dev/null 2>&1 && continue
    pending="$pending
$command_name||$spec"
  done
  IFS="$oldifs"

  echo "== config software =="
  # Ordered-candidate engine. Each round consumes the head candidate of every
  # pending record, batches it into a backend bucket, installs, then
  # re-verifies with `command -v`. Whatever is still missing advances to its
  # next candidate — mise → brew/pacman/aur/apt chains just fall out.
  for round in 1 2 3 4 5 6; do
    [ -z "$pending" ] && break
    brew_formulae=""; brew_casks=""; mise_specs=""
    pacman_specs=""; aur_specs=""; apt_specs=""
    local u rec_cmd
    oldifs="$IFS"; IFS=$'\n'
    for u in $pending; do
      IFS="$oldifs"
      [ -z "$u" ] && continue
      rec_cmd="${u%%|*}"
      candidates="${u#*|}"
      candidates="${candidates#*|}"
      detail="${candidates%%,*}"
      rest="${candidates#*,}"
      [ "$rest" = "$candidates" ] && rest=""
      backend="${detail%%:*}"
      local spec_pkg="${detail#*:}"
      case "$backend" in
        mise)    mise_specs="$mise_specs $spec_pkg" ;;
        formula) brew_formulae="$brew_formulae $spec_pkg" ;;
        cask)    brew_casks="$brew_casks $spec_pkg" ;;
        pacman)  pacman_specs="$pacman_specs $spec_pkg" ;;
        aur)     aur_specs="$aur_specs $spec_pkg" ;;
        apt)     apt_specs="$apt_specs $spec_pkg" ;;
        *)       missing_manual="$missing_manual $rec_cmd" ;;
      esac
      # Rewrite the record: consumed=head, remainder is next round's list.
      pending="${pending/$u/$rec_cmd|$detail|$rest}"
    done
    IFS="$oldifs"

    # Run every backend that collected specs this round.
    if [ -n "$mise_specs" ]; then
      if ensure_mise; then
        # Per-spec installs: a batch `mise install a b c` aborts on the first
        # failure, which would rob good specs of the verify pass.
        echo "install mise tools:$mise_specs"
        for detail in $mise_specs; do
          mise install "$detail" || \
            echo "warn    mise could not install $detail — trying fallback"
        done
      else
        echo "warn    mise unavailable — trying fallbacks"
      fi
    fi
    if [ -n "$brew_formulae$brew_casks" ]; then
      if command -v brew >/dev/null 2>&1; then
        if [ -n "$brew_formulae" ]; then
          echo "install brew formulae:$brew_formulae"
          brew install $brew_formulae || \
            echo "warn    brew formulae failed — trying fallbacks"
        fi
        if [ -n "$brew_casks" ]; then
          echo "install brew casks:$brew_casks"
          brew install --cask $brew_casks || \
            echo "warn    brew casks failed — trying fallbacks"
        fi
      else
        missing_manual="$missing_manual brew"
      fi
    fi
    if [ -n "$pacman_specs" ]; then
      if command -v pacman >/dev/null 2>&1; then
        echo "install Arch packages:$pacman_specs"
        run_privileged pacman -S --needed $pacman_specs || \
          echo "warn    pacman failed — trying fallbacks"
      else
        missing_manual="$missing_manual pacman"
      fi
    fi
    if [ -n "$aur_specs" ]; then
      local aur_helper=""
      if command -v yay >/dev/null 2>&1; then aur_helper=yay
      elif command -v paru >/dev/null 2>&1; then aur_helper=paru
      fi
      if [ -n "$aur_helper" ]; then
        echo "install AUR packages ($aur_helper):$aur_specs"
        $aur_helper -S --needed $aur_specs || \
          echo "warn    $aur_helper failed — trying fallbacks"
      else
        missing_manual="$missing_manual aur(yay -S$aur_specs)"
      fi
    fi
    if [ -n "$apt_specs" ]; then
      if command -v apt-get >/dev/null 2>&1; then
        echo "install Debian packages:$apt_specs"
        run_privileged apt-get update || true
        run_privileged apt-get install -y $apt_specs || \
          echo "warn    apt failed — trying fallbacks"
      else
        missing_manual="$missing_manual apt"
      fi
    fi

    # Verify: drop satisfied records, advance the rest to their next
    # candidate; exhausted records land in missing_manual.
    local next_pending=""
    oldifs="$IFS"; IFS=$'\n'
    for u in $pending; do
      IFS="$oldifs"
      [ -z "$u" ] && continue
      rec_cmd="${u%%|*}"
      detail="${u#*|}"; detail="${detail%%|*}"
      rest="${u#*|}";   rest="${rest#*|}"
      # Binaries verify via PATH; a consumed cask (GUI app, never on PATH)
      # verifies via `brew list --cask` on its basename.
      local sat=0
      if command -v "$rec_cmd" >/dev/null 2>&1; then
        sat=1
      elif [ "${detail%%:*}" = "cask" ]; then
        if command -v brew >/dev/null 2>&1 && \
           brew list --cask "${detail##*/}" >/dev/null 2>&1; then
          sat=1
        fi
      fi
      [ "$sat" = 1 ] && continue
      if [ -n "$rest" ]; then
        next_pending="$next_pending
$u"
      else
        missing_manual="$missing_manual $rec_cmd"
      fi
    done
    IFS="$oldifs"
    pending="$next_pending"
  done

  # The linked profile TOML owns the full CLI layer (fzf, fd, claude code,
  # ...), which has no SOFTWARE_TABLE entry — a bare `mise install` syncs
  # everything it declares.
  if software_selected mise-config "$wanted" && ensure_mise; then
    echo "install mise profile tools (mise/$(mise_profile).toml)"
    mise install || echo "warn    mise profile install incomplete"
  fi
  if software_selected nbshell-config "$wanted" && command -v pacman >/dev/null 2>&1; then
    local nbshell_pkgs
    nbshell_pkgs="$(read_package_file "$DOTFILES/nbshell/packages.arch.txt")"
    if [ -n "$nbshell_pkgs" ]; then
      echo "install nbshell Arch packages: $nbshell_pkgs"
      run_privileged pacman -S --needed $nbshell_pkgs || \
        echo "warn    nbshell packages failed — install manually"
    fi
  fi
  if [ -n "$missing_manual" ]; then
    echo "manual  no supported package mapping for:$missing_manual"
  elif [ -z "$pending" ]; then
    echo "ok      selected software already installed"
  fi
}

run_herdr_plugins() {
  echo "== herdr plugins =="
  if command -v herdr >/dev/null 2>&1; then
    bash "$DOTFILES/herdr/install-plugins.sh" || \
      echo "warn    herdr plugin install failed — run: dotfiles deps herdr"
  else
    echo "herdr not installed — skipped (run: dotfiles deps herdr)"
  fi
}

install_sheprd_linux() {
  local script
  script="$(mktemp "${TMPDIR:-/tmp}/dotfiles-sheprd.XXXXXX")"
  echo "install sheprd from $SHEPRD_INSTALL_URL"
  if ! curl -fsSL "$SHEPRD_INSTALL_URL" -o "$script"; then
    rm -f -- "$script"
    echo "dotfiles: could not download $SHEPRD_INSTALL_URL" >&2
    return 1
  fi
  if ! sh "$script"; then
    rm -f -- "$script"
    echo "dotfiles: sheprd install failed; rerun it from $SHEPRD_INSTALL_URL" >&2
    return 1
  fi
  rm -f -- "$script"
}

run_sheprd() {
  # macOS takes the tap cask from SOFTWARE_TABLE. No Linux repository packages
  # sheprd, and asking for it through an AUR helper would add a helper to the
  # bootstrap, so the upstream installer stays the single source of truth: it
  # resolves the latest release, verifies the package against the published
  # SHA-256 and installs it through pacman/apt/dnf/zypper with sudo.
  [ "$(host_uname)" = Linux ] || return 0
  command -v sheprd >/dev/null 2>&1 && return 0
  install_sheprd_linux
}
setup_pi_theme() {
  local theme_dir="$HOME/.pi/agent/themes"
  local theme_file="$theme_dir/nbshell.json"
  local fallback="$DOTFILES/pi-agent/themes/nbshell-tokyo-night.json"
  mkdir -p "$theme_dir"
  if [ "$(uname -s)" = "Darwin" ] || [ ! -f "$theme_file" ]; then
    cp "$fallback" "$theme_file"
    echo "theme   pi nbshell → Tokyo Night fallback"
  fi
}

run_config_runtimes() {
  local wanted="$1"
  if [ "${DOTFILES_SKIP_RUNTIME_INSTALLERS:-0}" = 1 ]; then
    echo "skip    config runtime installers (test mode)"
    return 0
  fi
  if software_selected herdr "$wanted"; then run_herdr_plugins; fi
  if software_selected sheprd "$wanted"; then run_sheprd; fi
  if software_selected zshrc "$wanted"; then run_zsh_deps; fi
  if software_selected clavis "$wanted"; then
    echo "== clavis (user-local, never sudo) =="
    bash "$DOTFILES/clavis/install.sh"
  fi
  if software_selected nbshell-config "$wanted"; then
    echo "== nbshell (user-local, never sudo) =="
    bash "$DOTFILES/nbshell/install.sh"
  fi
  if software_selected fcitx5-conf "$wanted"; then
    echo "== fcitx5 (user-local, never sudo) =="
    bash "$DOTFILES/fcitx5/install.sh"
  fi
  if software_selected pi-settings "$wanted"; then
    echo "== pi =="
    setup_pi_theme
    if [ ! -f "$HOME/.pi/agent/auth.json" ]; then
      echo "No pi API key yet. Create it (no login, providers are key-based):"
      echo "  printf '{\"$PI_DEFAULT_PROVIDER\": {\"type\": \"api_key\", \"key\": \"sk-...\"}}' > $HOME/.pi/agent/auth.json"
      echo "  chmod 600 $HOME/.pi/agent/auth.json"
    fi
  fi
}



cmd_deps() {
  # Install runtime software/deps without touching links (already-linked machines).
  local wanted
  wanted="$(expand_groups "$*")"
  if [ -z "$wanted" ]; then
    wanted="$(for e in "${LINK_TABLE[@]}"; do printf '%s ' "${e%%|*}"; done)"
  fi
  run_software_install "$wanted"
  if software_selected zshrc "$wanted"; then run_zsh_deps; fi
  if software_selected herdr "$wanted"; then run_herdr_plugins; fi
  if software_selected sheprd "$wanted"; then run_sheprd; fi
  echo "Done."
}

cmd_install() {
  local wanted="$1"
  if [ -z "$wanted" ]; then
    wanted="$(for entry in "${LINK_TABLE[@]}"; do printf '%s ' "${entry%%|*}"; done)"
  fi

  cmd_link
  echo
  run_software_install "$wanted"
  run_config_runtimes "$wanted"
  echo
  if software_selected pi-settings "$wanted"; then
    echo "Done. Start pi with: pi"
  else
    echo "Done."
  fi
}

load_homebrew() {
  if command -v brew >/dev/null 2>&1; then return 0; fi
  if [ -x /opt/homebrew/bin/brew ]; then
    eval "$(/opt/homebrew/bin/brew shellenv)"
  elif [ -x /usr/local/bin/brew ]; then
    eval "$(/usr/local/bin/brew shellenv)"
  elif [ -x /home/linuxbrew/.linuxbrew/bin/brew ]; then
    eval "$(/home/linuxbrew/.linuxbrew/bin/brew shellenv)"
  elif [ -x "$HOME/.linuxbrew/bin/brew" ]; then
    eval "$("$HOME/.linuxbrew/bin/brew" shellenv)"
  else
    echo "dotfiles: Homebrew installed but brew is not available in this shell" >&2
    return 1
  fi
}

ensure_homebrew() {
  if [ "${DOTFILES_FORCE_NO_BREW:-0}" != 1 ] && command -v brew >/dev/null 2>&1; then
    return 0
  fi
  command -v curl >/dev/null 2>&1 || {
    echo "dotfiles: curl is required to install Homebrew" >&2
    return 1
  }
  echo "install Homebrew from $HOMEBREW_INSTALL_URL"
  NONINTERACTIVE=1 "$BOOTSTRAP_BASH" -c "$(curl -fsSL "$HOMEBREW_INSTALL_URL")" || {
    echo "dotfiles: Homebrew bootstrap failed; rerun the installer from $HOMEBREW_INSTALL_URL" >&2
    return 1
  }
  if [ "${DOTFILES_FORCE_NO_BREW:-0}" = 1 ] && command -v brew >/dev/null 2>&1; then
    return 0
  fi
  load_homebrew
}

install_macos_base_packages() {
  brew install $MACOS_BASE_PACKAGES
}
cmd_setup() {
  local system="${1:-auto}" profile="${2:-auto}" extra="${3:-}" preset wanted
  echo "== detect system =="
  if [ -n "$extra" ]; then
    echo "dotfiles: setup accepts at most a system and one Linux profile" >&2
    return 1
  fi
  if [ "$system" = server ]; then
    if [ "$profile" != auto ]; then
      echo "dotfiles: 'setup server' does not accept another profile" >&2
      return 1
    fi
    system=linux
    profile=server
  fi
  if [ "$system" = arch ]; then
    if [ "$profile" != auto ]; then
      echo "dotfiles: deprecated 'setup arch' alias does not accept a profile" >&2
      return 1
    fi
    echo "deprecated: 'setup arch' is now 'setup linux omarchy'"
    system=linux
    profile=omarchy
  fi
  [ "$system" = auto ] && system="$(detect_system)"
  validate_system "$system"
  if [ "$(id -u)" -eq 0 ] && { [ "$system" != linux ] || [ "$profile" != server ]; }; then
    echo "dotfiles: root setup is supported only for the Linux server profile" >&2
    return 1
  fi
  if [ "$system" = linux ]; then
    [ "$profile" = auto ] && profile="$(detect_linux_profile)"
    validate_linux_profile "$profile"
    preset="linux-$profile"
    echo "system   linux"
    echo "profile  $profile"
  else
    if [ "$profile" != auto ]; then
      echo "dotfiles: macOS setup does not accept a Linux profile" >&2
      return 1
    fi
    preset=macos
    echo "system   macos"
  fi
  wanted="$(preset_entries "$preset")"
  echo "preset   $preset"
  printf 'entries %s\n' "$wanted"

  # Native OS packages first (build toolchains like base-devel/build-essential),
  # then Homebrew on macOS, then mise + per-OS config software.
  if [ "$preset" = linux-omarchy ] || [ "$preset" = linux-niri ]; then
    echo "== install native packages (pacman) =="
    install_arch_setup_packages
  elif [ "$preset" = linux-server ]; then
    echo "== install native packages (apt) =="
    install_debian_setup_packages
  fi

  if [ "$preset" = macos ]; then
    echo "== bootstrap package manager =="
    ensure_homebrew
    echo "== install base packages =="
    install_macos_base_packages
  fi

  echo "== install config software =="
  run_software_install "$wanted"
  echo "== link configs =="
  select_entries $wanted
  cmd_link

  echo "== install config runtimes =="
  run_config_runtimes "$wanted"

  echo "== manual follow-up =="
  case "$preset" in
    macos)
      echo "Start AeroSpace and grant Accessibility permission when prompted."
      echo "Optional: change the login shell manually with chsh."
      ;;
    linux-omarchy)
      echo "fcitx5 autostarts via Omarchy's default Hyprland config; IM env vars"
      echo "come from ~/.config/environment.d/fcitx.conf (imported by uwsm)."
      echo "If scratch registration failed, run: herdr-scratch link"
      ;;
    linux-niri)
      echo "  systemctl --user enable --now nbshell.service"
      echo "  sudo systemctl enable --now tuned.service"
      echo "If scratch registration failed, run: herdr-scratch link"
      ;;
    linux-server)
      echo "Headless profile complete; no desktop services or nbshell were installed."
      echo "Optional: change the login shell manually with chsh."
      ;;
  esac
}

case "${1:-}" in
  list)   cmd_list ;;
  status) shift; select_entries "$@"; cmd_status ;;
  link)   shift; select_entries "$@"; cmd_link ;;
  install) shift; select_entries "$@"; cmd_install "$(expand_groups "$*")" ;;
  deps) shift; cmd_deps "$@" ;;
  setup) shift; cmd_setup "${1:-auto}" "${2:-auto}" "${3:-}" ;;
  *)
    echo "Usage: dotfiles {list|status|link|install|deps|setup} [name...]"
    echo "  list                show every managed entry and its target"
    echo "  status [name...]    show link state (all entries by default)"
    echo "  link [name...]      create links; backup+replace conflicts"
    echo "  install [name...]   link + install selected config software/deps"
    echo "  deps [name...]      install selected config software/deps (no linking)"
    echo "  setup [auto|macos|linux|server] [auto|server|omarchy|niri]"
    echo "                      install a preset; 'setup server' is the root-friendly headless shortcut"
    echo
    echo "names: $(for e in "${LINK_TABLE[@]}"; do printf '%s ' "${e%%|*}"; done)"
    echo "groups: $(for g in "${GROUP_TABLE[@]}"; do printf '%s ' "${g%%|*}"; done)"
    exit 1
    ;;
esac