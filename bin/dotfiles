#!/bin/bash
# dotfiles — manage symlinks between ~ and ~/dotfiles
# Usage:
#   dotfiles list                     list every managed entry (name → target)
#   dotfiles status [name...]         show link state (all, or only named)
#   dotfiles link [name...]           create links; backup+replace conflicts
#   dotfiles install [name...]        link (+ herdr plugins, pi hint for all)
set -euo pipefail

DOTFILES="${DOTFILES_DIR:-$HOME/dotfiles}"

# Each entry: "<name>|<repo-relative-path>|<target>"
# `name` is what you pass to status/link/install to act on that one dotfile.
LINK_TABLE=(
  "dotfiles-cli|bin/dotfiles|$HOME/.local/bin/dotfiles"
  "aerospace|aerospace/aerospace.toml|$HOME/.aerospace.toml"
  "zshrc|zsh/zshrc|$HOME/.zshrc"
  "zshenv|zsh/zshenv|$HOME/.zshenv"
  "zprofile|zsh/zprofile|$HOME/.zprofile"
  "shinit|zsh/shinit|$HOME/.shinit"
  "p10k|zsh/p10k.zsh|$HOME/.p10k.zsh"
  "nvim|nvim|$HOME/.config/nvim"
  "kaku|kaku|$HOME/.config/kaku"
  "niri|niri|$HOME/.config/niri"
  "waybar|waybar|$HOME/.config/waybar"
  "clavis|clavis/config|$HOME/.config/clavis"
  "nbshell|nbshell/config/config.json|$HOME/.config/nbshell/config.json"
  "fastfetch|fastfetch|$HOME/.config/fastfetch"
  "pi-settings|pi-agent/settings.json|$HOME/.pi/agent/settings.json"
  "pi-models|pi-agent/models.json|$HOME/.pi/agent/models.json"
  "pi-extensions|pi-agent/extensions|$HOME/.pi/agent/extensions"
  "herdr|herdr/config.toml|$HOME/.config/herdr/config.toml"
  "kitty-main|kitty/kitty.conf|$HOME/.config/kitty/kitty.conf"
  "kitty-linux|kitty/platform-linux.conf|$HOME/.config/kitty/platform-linux.conf"
  "kitty-macos|kitty/platform-macos.conf|$HOME/.config/kitty/platform-macos.conf"
)

# Runtime software used by managed configs.
# Each entry: "<managed-name>|<command>|<brew-kind>|<brew-package>|<arch-package>".
# brew-kind is formula/cask/npm; "-" means unavailable on that platform.
SOFTWARE_TABLE=(
  "aerospace|aerospace|cask|nikitabobko/tap/aerospace|-"
  "zshrc|zsh|formula|zsh|zsh"
  "nvim|nvim|formula|neovim|neovim"
  "niri|niri|-|-|niri"
  "waybar|waybar|-|-|waybar"
  "nbshell|qs|-|-|quickshell"
  "nbshell|fcitx5|-|-|fcitx5-im"
  "nbshell|kitty|cask|kitty|kitty"
  "fastfetch|fastfetch|formula|fastfetch|fastfetch"
  "pi-settings|pi|npm|@earendil-works/pi-coding-agent|-"
  "herdr|herdr|formula|herdr|-"
  "herdr|go|formula|go|go"
  "herdr|tmux|formula|tmux|tmux"
  "herdr|cargo|formula|rust|rust"
  "herdr|yazi|formula|yazi|yazi"
  "herdr|herdr-scratch|cask|macintacos/tap/herdr-scratch|-"
)

# Group aliases: "<alias>|<space-separated names>". Passing the alias to
# status/link/install expands to all members, e.g. `dotfiles link pi`.
GROUP_TABLE=(
  "pi|pi-settings pi-models pi-extensions"
  "zsh|zshrc zshenv zprofile shinit p10k"
  "kitty|kitty-main kitty-linux kitty-macos"
  "herdr|herdr"
  "wm|niri nbshell"
)

# System setup presets contain primary configs only; rollback configs stay manual.
PRESET_TABLE=(
  "macos|dotfiles-cli zsh nvim fastfetch pi herdr aerospace kitty"
  "arch|dotfiles-cli zsh nvim fastfetch pi herdr niri nbshell kitty"
)

# Expand aliases in "$*" to concrete names (set -u + empty string is fine here).
expand_groups() {
  local w a members out
  out=""
  for w in $1; do
    members=""
    for a in "${GROUP_TABLE[@]}"; do
      if [ "${a%%|*}" = "$w" ]; then members="${a#*|}"; break; fi
    done
    if [ -n "$members" ]; then out="$out $members"; else out="$out $w"; fi
  done
  echo "$out"
}

host_uname() {
  if [ -n "${DOTFILES_UNAME:-}" ]; then
    printf '%s\n' "$DOTFILES_UNAME"
  else
    uname -s
  fi
}

is_arch_host() {
  local os_release="${DOTFILES_OS_RELEASE:-/etc/os-release}" id="" id_like=""
  [ "$(host_uname)" = "Linux" ] || return 1
  [ -r "$os_release" ] || return 1
  id="$(sed -n 's/^ID=//p' "$os_release" | head -n 1 | tr -d '\"')"
  id_like="$(sed -n 's/^ID_LIKE=//p' "$os_release" | head -n 1 | tr -d '\"')"
  [ "$id" = "arch" ] && return 0
  case " $id_like " in *" arch "*) return 0 ;; esac
  return 1
}

detect_system() {
  if [ "$(host_uname)" = "Darwin" ]; then
    echo macos
  elif is_arch_host; then
    echo arch
  else
    echo "dotfiles: unsupported system; supported presets: macos arch" >&2
    return 1
  fi
}

validate_system() {
  case "$1" in
    macos)
      [ "$(host_uname)" = "Darwin" ] || {
        echo "dotfiles: setup macos requires macOS" >&2
        return 1
      }
      ;;
    arch)
      is_arch_host || {
        echo "dotfiles: setup arch requires Arch Linux" >&2
        return 1
      }
      ;;
    *)
      echo "dotfiles: unknown setup preset '$1' (supported: auto macos arch)" >&2
      return 1
      ;;
  esac
}

preset_entries() {
  local preset="$1" row
  for row in "${PRESET_TABLE[@]}"; do
    if [ "${row%%|*}" = "$preset" ]; then
      expand_groups "${row#*|}"
      return 0
    fi
  done
  return 1
}

# Defaults used by the /login-free key setup (see README)
PI_DEFAULT_PROVIDER="new-api"
HOMEBREW_INSTALL_URL="${DOTFILES_HOMEBREW_INSTALL_URL:-https://raw.githubusercontent.com/Homebrew/install/HEAD/install.sh}"
BOOTSTRAP_BASH="${DOTFILES_BASH_BIN:-/bin/bash}"
MACOS_BASE_PACKAGES="git zsh node go"
ARCH_BASE_PACKAGES="git curl file procps-ng zsh nodejs npm go base-devel"

select_entries() {
  # "$*" joins args with spaces; empty when no names given (all entries).
  # Plain-string iteration keeps this bash 3.2-safe (empty arrays + set -u
  # are broken in old bash).
  local wanted="$*" entry name w ok nl
  wanted="$(expand_groups "$wanted")"
  nl=$'\n'
  SELECTED=""
  for entry in "${LINK_TABLE[@]}"; do
    name="${entry%%|*}"
    if [ -z "$wanted" ]; then
      SELECTED="${SELECTED}${entry}$nl"
    else
      for w in $wanted; do
        if [ "$w" = "$name" ]; then SELECTED="${SELECTED}${entry}$nl"; break; fi
      done
    fi
  done
  for w in $wanted; do
    ok=0
    for entry in "${LINK_TABLE[@]}"; do
      [ "$w" = "${entry%%|*}" ] && { ok=1; break; }
    done
    if [ "$ok" = 0 ]; then echo "dotfiles: unknown entry '$w' (see 'dotfiles list')" >&2; fi
  done
}

cmd_list() {
  local name src target
  printf "%-14s %-55s %s\n" "NAME" "SOURCE" "TARGET"
  for entry in "${LINK_TABLE[@]}"; do
    name="${entry%%|*}"
    src="${entry#*|}"
    target="${src#*|}"
    src="${src%%|*}"
    printf "%-14s %-55s %s\n" "$name" "$src" "$target"
  done
}

cmd_status() {
  local name src target state points oldifs
  printf "%-14s %-50s %s\n" "NAME" "TARGET" "STATE"
  oldifs="$IFS"; IFS=$'\n'
  for entry in $SELECTED; do
    IFS="$oldifs"
    name="${entry%%|*}"
    src="${entry#*|}"
    target="${src#*|}"
    src="${src%%|*}"
    if [ -L "$target" ]; then
      points="$(readlink "$target" 2>/dev/null || true)"
      if [ "$points" = "$DOTFILES/$src" ]; then
        state="ok"
      else
        state="STALE → $points"
      fi
      printf "%-14s %-50s %s\n" "$name" "$target" "$state"
    elif [ -e "$target" ]; then
      printf "%-14s %-50s %s\n" "$name" "$target" "CONFLICT (real file)"
    else
      printf "%-14s %-50s %s\n" "$name" "$target" "missing"
    fi
  done
}

cmd_link() {
  local name src target backup_dir ts oldifs
  backup_dir="${DOTFILES_BACKUP_DIR:-$HOME/.dotfiles-backup-$(date +%Y%m%d-%H%M%S)}"
  ts=0
  oldifs="$IFS"; IFS=$'\n'
  for entry in $SELECTED; do
    IFS="$oldifs"
    name="${entry%%|*}"
    src="${entry#*|}"
    target="${src#*|}"
    src="${src%%|*}"
    mkdir -p "$(dirname "$target")"
    if [ -L "$target" ]; then
      if [ "$(readlink "$target" 2>/dev/null || true)" = "$DOTFILES/$src" ]; then
        echo "ok      $name ($target)"
      else
        echo "repair  $name → $DOTFILES/$src"
        ln -sfn "$DOTFILES/$src" "$target"
      fi
      continue
    fi
    if [ -e "$target" ]; then
      if [ "$ts" = 0 ]; then
        mkdir -p "$backup_dir"
        echo "backups → $backup_dir"
        ts=1
      fi
      mv "$target" "$backup_dir/"
      echo "backup  $name ($target)"
    fi
    ln -sfn "$DOTFILES/$src" "$target"
    echo "link    $name ($target)"
  done
}

run_zsh_deps() {
  echo "== zsh deps =="
  if command -v git >/dev/null 2>&1; then
    bash "$DOTFILES/zsh/install-deps.sh"
  else
    echo "git not installed — skipped (required to clone zsh plugins)"
  fi
}

software_selected() {
  local owner="$1" wanted="$2" w
  for w in $wanted; do
    [ "$w" = "$owner" ] && return 0
  done
  return 1
}

read_package_file() {
  sed -e 's/[[:space:]]*#.*$//' -e '/^[[:space:]]*$/d' "$1" | tr '\n' ' '
}

arch_packages_for() {
  local wanted="$1" entry owner command_name brew_kind brew_package arch_package packages="$ARCH_BASE_PACKAGES"
  for entry in "${SOFTWARE_TABLE[@]}"; do
    owner="${entry%%|*}"
    software_selected "$owner" "$wanted" || continue
    entry="${entry#*|}"; command_name="${entry%%|*}"
    entry="${entry#*|}"; brew_kind="${entry%%|*}"
    entry="${entry#*|}"; brew_package="${entry%%|*}"
    arch_package="${entry#*|}"
    [ "$arch_package" = "-" ] || packages="$packages $arch_package"
  done
  if software_selected nbshell "$wanted"; then
    packages="$packages $(read_package_file "$DOTFILES/nbshell/packages.arch.txt")"
  fi
  printf '%s\n' "$packages"
}

install_arch_setup_packages() {
  local wanted="$1" packages
  command -v pacman >/dev/null 2>&1 || {
    echo "dotfiles: pacman is required for setup arch" >&2
    return 1
  }
  command -v sudo >/dev/null 2>&1 || {
    echo "dotfiles: sudo is required for setup arch" >&2
    return 1
  }
  packages="$(arch_packages_for "$wanted")"
  sudo pacman -S --needed $packages
}

run_software_install() {
  local wanted="$1" skip_arch="${2:-0}" entry owner command_name brew_kind brew_package arch_package
  local brew_formulae="" brew_casks="" npm_packages="" arch_packages=""
  local missing_manual="" oldifs
  oldifs="$IFS"; IFS=$'\n'
  for entry in "${SOFTWARE_TABLE[@]}"; do
    IFS="$oldifs"
    owner="${entry%%|*}"
    software_selected "$owner" "$wanted" || continue
    entry="${entry#*|}"; command_name="${entry%%|*}"
    entry="${entry#*|}"; brew_kind="${entry%%|*}"
    entry="${entry#*|}"; brew_package="${entry%%|*}"
    arch_package="${entry#*|}"
    if [ "$skip_arch" = 1 ] && { [ "$arch_package" != "-" ] && [ "$brew_package" = "-" ] || [ "$brew_kind" = cask ]; }; then
      continue
    fi
    command -v "$command_name" >/dev/null 2>&1 && continue
    if [ "$brew_kind" = "npm" ]; then
      if command -v npm >/dev/null 2>&1; then
        npm_packages="$npm_packages $brew_package"
      else
        missing_manual="$missing_manual npm"
      fi
    elif command -v brew >/dev/null 2>&1 && [ "$brew_package" != "-" ]; then
      case "$brew_kind" in
        formula) brew_formulae="$brew_formulae $brew_package" ;;
        cask) brew_casks="$brew_casks $brew_package" ;;
      esac
    elif [ "$skip_arch" != 1 ] && command -v pacman >/dev/null 2>&1 && [ "$arch_package" != "-" ]; then
      arch_packages="$arch_packages $arch_package"
    else
      missing_manual="$missing_manual $command_name"
    fi
  done
  IFS="$oldifs"

  echo "== config software =="
  if [ -n "$brew_formulae" ]; then
    echo "install brew formulae:$brew_formulae"
    brew install $brew_formulae
  fi
  if [ -n "$brew_casks" ]; then
    echo "install brew casks:$brew_casks"
    brew install --cask $brew_casks
  fi
  if [ -n "$npm_packages" ]; then
    echo "install npm packages:$npm_packages"
    npm install -g $npm_packages
  fi
  if [ -n "$arch_packages" ]; then
    echo "install Arch packages:$arch_packages"
    sudo pacman -S --needed $arch_packages
  fi
  if [ -n "$missing_manual" ]; then
    echo "manual  no supported package mapping for:$missing_manual"
  fi
  if [ -z "$brew_formulae$brew_casks$npm_packages$arch_packages$missing_manual" ]; then
    echo "ok      selected software already installed"
  fi
}

run_herdr_plugins() {
  echo "== herdr plugins =="
  if command -v herdr >/dev/null 2>&1; then
    bash "$DOTFILES/herdr/install-plugins.sh"
  else
    echo "herdr not installed — skipped (brew install herdr)"
  fi
}
setup_pi_theme() {
  local theme_dir="$HOME/.pi/agent/themes"
  local theme_file="$theme_dir/nbshell.json"
  local fallback="$DOTFILES/pi-agent/themes/nbshell-tokyo-night.json"
  mkdir -p "$theme_dir"
  if [ "$(uname -s)" = "Darwin" ] || [ ! -f "$theme_file" ]; then
    cp "$fallback" "$theme_file"
    echo "theme   pi nbshell → Tokyo Night fallback"
  fi
}

run_config_runtimes() {
  local wanted="$1"
  if [ "${DOTFILES_SKIP_RUNTIME_INSTALLERS:-0}" = 1 ]; then
    echo "skip    config runtime installers (test mode)"
    return 0
  fi
  if software_selected herdr "$wanted"; then run_herdr_plugins; fi
  if software_selected zshrc "$wanted"; then run_zsh_deps; fi
  if software_selected clavis "$wanted"; then
    echo "== clavis (user-local, never sudo) =="
    bash "$DOTFILES/clavis/install.sh"
  fi
  if software_selected nbshell "$wanted"; then
    echo "== nbshell (user-local, never sudo) =="
    bash "$DOTFILES/nbshell/install.sh"
  fi
  if software_selected pi-settings "$wanted"; then
    echo "== pi =="
    setup_pi_theme
    if [ ! -f "$HOME/.pi/agent/auth.json" ]; then
      echo "No pi API key yet. Create it (no login, providers are key-based):"
      echo "  printf '{\"$PI_DEFAULT_PROVIDER\": {\"type\": \"api_key\", \"key\": \"sk-...\"}}' > $HOME/.pi/agent/auth.json"
      echo "  chmod 600 $HOME/.pi/agent/auth.json"
    fi
  fi
}



cmd_deps() {
  # Install runtime software/deps without touching links (already-linked machines).
  local wanted
  wanted="$(expand_groups "$*")"
  if [ -z "$wanted" ]; then
    wanted="$(for e in "${LINK_TABLE[@]}"; do printf '%s ' "${e%%|*}"; done)"
  fi
  run_software_install "$wanted"
  if software_selected zshrc "$wanted"; then run_zsh_deps; fi
  if software_selected herdr "$wanted"; then run_herdr_plugins; fi
  echo "Done."
}

cmd_install() {
  local wanted="$1"
  if [ -z "$wanted" ]; then
    wanted="$(for entry in "${LINK_TABLE[@]}"; do printf '%s ' "${entry%%|*}"; done)"
  fi

  cmd_link
  echo
  run_software_install "$wanted"
  run_config_runtimes "$wanted"
  echo
  if software_selected pi-settings "$wanted"; then
    echo "Done. Start pi with: pi"
  else
    echo "Done."
  fi
}

load_homebrew() {
  if command -v brew >/dev/null 2>&1; then return 0; fi
  if [ -x /opt/homebrew/bin/brew ]; then
    eval "$(/opt/homebrew/bin/brew shellenv)"
  elif [ -x /usr/local/bin/brew ]; then
    eval "$(/usr/local/bin/brew shellenv)"
  elif [ -x /home/linuxbrew/.linuxbrew/bin/brew ]; then
    eval "$(/home/linuxbrew/.linuxbrew/bin/brew shellenv)"
  elif [ -x "$HOME/.linuxbrew/bin/brew" ]; then
    eval "$("$HOME/.linuxbrew/bin/brew" shellenv)"
  else
    echo "dotfiles: Homebrew installed but brew is not available in this shell" >&2
    return 1
  fi
}

ensure_homebrew() {
  if [ "${DOTFILES_FORCE_NO_BREW:-0}" != 1 ] && command -v brew >/dev/null 2>&1; then
    return 0
  fi
  command -v curl >/dev/null 2>&1 || {
    echo "dotfiles: curl is required to install Homebrew" >&2
    return 1
  }
  echo "install Homebrew from $HOMEBREW_INSTALL_URL"
  NONINTERACTIVE=1 "$BOOTSTRAP_BASH" -c "$(curl -fsSL "$HOMEBREW_INSTALL_URL")" || {
    echo "dotfiles: Homebrew bootstrap failed; rerun the installer from $HOMEBREW_INSTALL_URL" >&2
    return 1
  }
  if [ "${DOTFILES_FORCE_NO_BREW:-0}" = 1 ] && command -v brew >/dev/null 2>&1; then
    return 0
  fi
  load_homebrew
}

install_macos_base_packages() {
  brew install $MACOS_BASE_PACKAGES
}
cmd_setup() {
  local preset="${1:-auto}" wanted
  echo "== detect system =="
  [ "$preset" = auto ] && preset="$(detect_system)"
  validate_system "$preset"
  wanted="$(preset_entries "$preset")"
  echo "preset  $preset"
  printf 'entries %s\n' "$wanted"
  if [ "$preset" = arch ]; then
    echo "== install native packages =="
    install_arch_setup_packages "$wanted"
  fi
  echo "== bootstrap package manager =="
  ensure_homebrew
  if [ "$preset" = macos ]; then
    echo "== install base packages =="
    install_macos_base_packages
  fi
  echo "== install config software =="
  if [ "$preset" = arch ]; then
    run_software_install "$wanted" 1
  else
    run_software_install "$wanted"
  fi

  echo "== link configs =="
  select_entries $wanted
  cmd_link

  echo "== install config runtimes =="
  run_config_runtimes "$wanted"

  echo "== manual follow-up =="
  case "$preset" in
    macos)
      echo "Start AeroSpace and grant Accessibility permission when prompted."
      echo "Optional: change the login shell manually with chsh."
      ;;
    arch)
      echo "  systemctl --user enable --now nbshell.service"
      echo "  sudo systemctl enable --now tuned.service"
      echo "If scratch registration failed, run: herdr-scratch link"
      ;;
  esac
}

case "${1:-}" in
  list)   cmd_list ;;
  status) shift; select_entries "$@"; cmd_status ;;
  link)   shift; select_entries "$@"; cmd_link ;;
  install) shift; select_entries "$@"; cmd_install "$(expand_groups "$*")" ;;
  deps) shift; cmd_deps "$@" ;;
  setup) shift; cmd_setup "${1:-auto}" ;;
  *)
    echo "Usage: dotfiles {list|status|link|install|deps|setup} [name...]"
    echo "  list                show every managed entry and its target"
    echo "  status [name...]    show link state (all entries by default)"
    echo "  link [name...]      create links; backup+replace conflicts"
    echo "  install [name...]   link + install selected config software/deps"
    echo "  deps [name...]      install selected config software/deps (no linking)"
    echo "  setup [auto|macos|arch]  install and configure the primary system preset"
    echo
    echo "names: $(for e in "${LINK_TABLE[@]}"; do printf '%s ' "${e%%|*}"; done)"
    echo "groups: $(for g in "${GROUP_TABLE[@]}"; do printf '%s ' "${g%%|*}"; done)"
    exit 1
    ;;
esac