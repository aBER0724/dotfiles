diff --git a/shell/Bar/Widgets/TrayEntry.qml b/shell/Bar/Widgets/TrayEntry.qml
new file mode 100644
index 0000000..091deab
--- /dev/null
+++ b/shell/Bar/Widgets/TrayEntry.qml
@@ -0,0 +1,77 @@
+import QtQuick
+import Quickshell
+import Quickshell.Services.SystemTray
+import Quickshell.Widgets
+import qs.Common
+
+Item {
+    id: entry
+
+    required property var trayItem
+    required property var trayRoot
+    required property bool pinned
+
+    width: Theme.cellH
+    height: Theme.cellH
+    opacity: iconDrag.active ? 0.45 : 1
+    property real lastDragX: 0
+
+    IconImage {
+        anchors.fill: parent
+        source: entry.trayItem.icon
+        opacity: entry.trayItem.status === Status.Passive ? 0.5 : 1
+    }
+
+    MouseArea {
+        anchors.fill: parent
+        hoverEnabled: true
+        acceptedButtons: Qt.LeftButton | Qt.MiddleButton | Qt.RightButton
+
+        onClicked: mouseEvent => {
+            const item = entry.trayItem;
+            if (mouseEvent.button === Qt.MiddleButton) {
+                item.secondaryActivate();
+                return;
+            }
+            if (item.hasMenu) {
+                const point = entry.mapToItem(null, mouseEvent.x, mouseEvent.y);
+                item.display(entry.QsWindow.window, Math.round(point.x), Math.round(point.y));
+                return;
+            }
+            if (mouseEvent.button === Qt.LeftButton)
+                item.activate();
+        }
+
+        onWheel: wheelEvent => entry.trayItem.scroll(wheelEvent.angleDelta.y, false)
+    }
+
+    DragHandler {
+        id: iconDrag
+        target: null
+        acceptedButtons: Qt.LeftButton
+        grabPermissions: PointerHandler.CanTakeOverFromAnything
+        cursorShape: active ? Qt.ClosedHandCursor : Qt.OpenHandCursor
+
+        onTranslationChanged: if (active)
+            entry.lastDragX = translation.x
+
+        onActiveChanged: {
+            entry.trayRoot.setDragging(active);
+            if (active) {
+                entry.lastDragX = 0;
+                return;
+            }
+            // DragHandler may reset translation before active becomes false. Use
+            // the last position captured while the pointer grab was active.
+            const dx = entry.lastDragX;
+            // Each delegate knows which side it started on. Crossing toward the
+            // other zone is therefore directional and does not depend on a
+            // divider coordinate that moves while the tray width animates.
+            if (!entry.pinned && dx >= Theme.cellW)
+                entry.trayRoot.setPinned(entry.trayRoot.itemKey(entry.trayItem), true);
+            else if (entry.pinned && dx <= -Theme.cellW)
+                entry.trayRoot.setPinned(entry.trayRoot.itemKey(entry.trayItem), false);
+            entry.lastDragX = 0;
+        }
+    }
+}
