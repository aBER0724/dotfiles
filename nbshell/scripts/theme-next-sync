#!/usr/bin/env bash
# Atomically advance nbshell, wait until config.json reflects the new theme,
# then export/reload every application palette.
set -euo pipefail

export PATH="$HOME/.local/bin:$PATH"
export WAYLAND_DISPLAY="${WAYLAND_DISPLAY:-wayland-1}"
config="${XDG_CONFIG_HOME:-$HOME/.config}/nbshell/config.json"
sync="${XDG_CONFIG_HOME:-$HOME/.config}/nbshell/theme-sync.py"
log="${XDG_STATE_HOME:-$HOME/.local/state}/nbshell/theme-sync.log"
mkdir -p "$(dirname "$log")"

before=$(python3 -c 'import json,sys; print(json.load(open(sys.argv[1])).get("theme", ""))' "$config")
result=$(nbshell next)

# Config.set() writes atomically. Wait for that write rather than relying on a
# fixed sleep, which could export the previous theme under load.
after="$before"
for _ in $(seq 1 30); do
  after=$(python3 -c 'import json,sys; print(json.load(open(sys.argv[1])).get("theme", ""))' "$config" 2>/dev/null || true)
  [ -n "$after" ] && [ "$after" != "$before" ] && break
  sleep 0.05
done

"$sync"
printf '%s %s -> %s (ipc: %s)\n' "$(date --iso-8601=seconds)" "$before" "$after" "$result" >> "$log"
