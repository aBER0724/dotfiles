{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",

  // Render the PNG through kitty's native graphics protocol.
  // Module icons require a Nerd Font.
  "logo": {
    "source": "~/.config/fastfetch/rx.png",
    "type": "kitty-direct",
    "width": 30,
    "preserveAspectRatio": true,
    "padding": {
      "top": 4,
      "left": 1,
      "right": 2
    }
  },

  "display": {
    "separator": " ",
    "brightColor": true,
    "color": {
      "keys": "blue",
      "output": "white"
    },
    "key": {
      "width": 3,
      "type": "string"
    },
    "duration": {
      "abbreviation": true
    }
  },

  "modules": [
    {
      "type": "title",
      "format": "{user-name-colored}@{host-name-colored}",
      "color": {
        "user": "cyan",
        "at": "cyan",
        "host": "cyan"
      }
    },
    {
      "type": "os",
      "key": "󰣇",
      "format": "{pretty-name} {arch}"
    },
    {
      "type": "kernel",
      "key": "",
      "format": "{sysname} {release}"
    },
    {
      "type": "packages",
      "key": "󰏗"
    },
    {
      "type": "shell",
      "key": "",
      "format": "{pretty-name} {version}"
    },
    {
      "type": "terminal",
      "key": "",
      "format": "{pretty-name} {version}"
    },
    {
      "type": "wm",
      "key": "",
      "format": "{plugin-name}"
    },
    {
      "type": "cursor",
      "key": ""
    },
    {
      "type": "terminalfont",
      "key": "",
      "format": "{name} ({size}pt)"
    },
    {
      "type": "uptime",
      "key": "󰅐",
      "format": "{formatted}"
    },
    {
      "type": "datetime",
      "key": "󰃭",
      "format": "{year}-{month-pretty}-{day-pretty}"
    },
    {
      "type": "media",
      "key": "",
      "format": "{combined}"
    },
    {
      "type": "player",
      "key": "",
      "format": "{player}"
    },
    {
      "type": "colors",
      "paddingLeft": 0,
      "symbol": "circle"
    }
  ]
}
