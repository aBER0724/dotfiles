# macOS
.DS_Store
.AppleDouble
.LSOverride
._*

# Editors
*.swp
*.swo
*~
.idea/
.vscode/

# Shell/misc
*.log
core

# Python bytecode (kitty/*.py, nbshell/scripts/*.py run from the repo)
__pycache__/
*.pyc

# kaku runtime artifacts (config dir uses its own .gitignore too)
kaku/.alma-snapshots/
sk-kaku
kaku/assistant.toml
kaku/state.json

# fast-syntax-highlighting build caches
kaku/zsh/plugins/fast-syntax-highlighting/.fast-*

# local backups
.backup-*/

# herdr runtime artifacts (installed plugins live in ~/.config/herdr/plugins, rebuilt)
.config/herdr/plugins/
herdr-client.log
herdr-server.log
herdr.sock
herdr-client.sock
.plugins.lock
session.json
release-notes.json
config.toml.hunkdiff-backup
herdr/scratch/bin/
# private credentials (never commit)
private/

# tool artifacts
.spec-workflow/

# pi local-only model providers (merged into models.merged.json at link time)
pi-agent/models.local.json
pi-agent/models.merged.json
