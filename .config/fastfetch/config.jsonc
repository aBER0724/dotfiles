{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "source": "~/.config/fastfetch/kuuga.png",
    "type": "chafa",
    "width": 30,
    "height": 18,
    "padding": {
      "top": 0,
      "left": 1,
      "right": 2
    }
  },
  "display": {
    "separator": "  →  ",
    "color": "cyan",
    "key": {
      "width": 10
    }
  },
  "modules": [
    {
      "type": "custom",
      "format": ""
    },
    {
      "type": "title",
      "color": {
        "user": "cyan",
        "at": "white",
        "host": "blue"
      },
      "fqdn": false
    },
    {
      "type": "custom",
      "format": "\u001b[36m───────────────────────────\u001b[0m"
    },
    {
      "type": "os",
      "key": "OS",
      "keyColor": "blue",
      "format": "{pretty-name}"
    },
    {
      "type": "host",
      "key": "Host",
      "keyColor": "blue"
    },
    {
      "type": "kernel",
      "key": "Kernel",
      "keyColor": "blue"
    },
    {
      "type": "uptime",
      "key": "Uptime",
      "keyColor": "green"
    },
    {
      "type": "shell",
      "key": "Shell",
      "keyColor": "green"
    },
    {
      "type": "cpu",
      "key": "CPU",
      "keyColor": "yellow",
      "showPeCoreCount": false,
      "temp": false
    },
    {
      "type": "memory",
      "key": "Memory",
      "keyColor": "yellow"
    },
    {
      "type": "disk",
      "key": "Disk",
      "keyColor": "yellow",
      "folders": "/"
    },
    {
      "type": "battery",
      "key": "Battery",
      "keyColor": "red"
    },
    {
      "type": "packages",
      "key": "Packages",
      "keyColor": "magenta"
    },
    {
      "type": "custom",
      "format": "\u001b[36m───────────────────────────\u001b[0m"
    },
    {
      "type": "colors",
      "paddingLeft": 1,
      "symbol": "circle"
    },
    {
      "type": "custom",
      "format": ""
    }
  ]
}
