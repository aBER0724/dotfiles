// niri 配置 — macOS / AeroSpace 风格按键(主键 = Alt)
// 修改本文件后 niri 会自动热重载,无需重启。
// 校验:`niri validate`

// 焦点环 / 边框 / 标签指示器颜色 —— nbshell 每次换主题都会重写这个文件
include "nbshell-colors.kdl"

input {
    keyboard {
        xkb {
            layout "us"
            options "ctrl:nocaps"
        }
        track-layout "global"
    }

    touchpad {
        tap
        natural-scroll
    }

    mouse {
        accel-profile "flat"
    }

    // 鼠标悬停即聚焦窗口
    focus-follows-mouse
}

// 外接显示器 DP-2 (H24T27 @ 100Hz)
output "DP-2" {
    mode "2560x1440@100"
}
// 内屏 eDP-1 (2880x1800,高分屏缩放 ~167%)
output "eDP-1" {
    scale 1.6666
}

// ── 命名工作区(AeroSpace 式固定 9 个,始终存在)──────
workspace "1" {}
workspace "2" {}
workspace "3" {}
workspace "4" {}
workspace "5" {}
workspace "Q" {}
workspace "W" {}
workspace "E" {}
workspace "R" {}

layout {
    gaps 8
    center-focused-column "on-overflow"  // never/always/on-overflow

    default-column-width {
        proportion 0.5
    }

    focus-ring {
        // 宽度在此设置;颜色来自上方 include 的 nbshell-colors.kdl
        width 2
    }

    preset-column-widths {
        // 无名字列表:Mod+Ctrl+1/2 循环切换(官方写法)
        proportion 0.33333
        proportion 0.5
        proportion 0.66667
        // fixed 1920  // 也可以按逻辑像素固定宽度
    }
}

// fcitx5 输入法环境变量由 ~/.config/environment.d/fcitx.conf 全局注入(本 niri 构建无 env 节点)

// ── 开机自启 ──────────────────────────────────────
spawn-at-startup "sh" "-c" "systemctl --user start nbshell.service"  // nbshell Nerd/TUI Quickshell 桌面 Shell
spawn-at-startup "fcitx5" "-d"
spawn-at-startup "cc-switch"

binds {
    // ── 终端 & 启动器 ─────────────────────────────
    Alt+Return { spawn "bash" "-c" "exec $HOME/.local/bin/kitty"; }
    Alt+Space  { spawn "bash" "-c" "PATH=$HOME/.local/bin:$PATH nbshell launcher"; }  // nbshell 启动器

    // ── 窗口 ──────────────────────────────────────
    Alt+C            { close-window; }          // 关闭窗口(macOS Cmd+W 习惯,C 键防冲突)
    Alt+F            { fullscreen-window; }     // 全屏
    Alt+Shift+F      { toggle-window-floating; } // 浮动/平铺切换
    Alt+M            { maximize-column; }       // 最大化列
    Alt+Shift+M      { center-window; }         // 居中窗口

    // ── 焦点(AeroSpace 映射:H=左 J=下 K=上 L=右)─
    Alt+H       { focus-column-left; }
    Alt+L       { focus-column-right; }
    Alt+J       { focus-window-down; }
    Alt+K       { focus-window-up; }
    Alt+Ctrl+H  { focus-monitor-left; }
    Alt+Ctrl+L  { focus-monitor-right; }

    // ── 移动窗口 ──────────────────────────────────
    Alt+Shift+H        { move-column-left; }
    Alt+Shift+L        { move-column-right; }
    Alt+Shift+J        { move-window-down; }
    Alt+Shift+K        { move-window-up; }
    Alt+Ctrl+Shift+H   { move-column-to-monitor-left; }
    Alt+Ctrl+Shift+L   { move-column-to-monitor-right; }
    Alt+Home           { move-column-to-first; }
    Alt+End            { move-column-to-last; }

    // ── 列宽 ──────────────────────────────────────
    Alt+Shift+Minus { set-column-width "-10%"; }
    Alt+Shift+Equal { set-column-width "+10%"; }
    Alt+Ctrl+1 { switch-preset-column-width; }       // 循环列宽预设
    Alt+Ctrl+2 { switch-preset-column-width-back; }  // 反向循环

    // ── 工作区(AeroSpace 映射:1-5 + QWER)─────────
    Alt+1       { focus-workspace "1"; }
    Alt+2       { focus-workspace "2"; }
    Alt+3       { focus-workspace "3"; }
    Alt+4       { focus-workspace "4"; }
    Alt+5       { focus-workspace "5"; }
    Alt+Q       { focus-workspace "Q"; }
    Alt+W       { focus-workspace "W"; }
    Alt+E       { focus-workspace "E"; }
    Alt+R       { focus-workspace "R"; }

    Alt+Shift+1 { move-window-to-workspace "1"; }
    Alt+Shift+2 { move-window-to-workspace "2"; }
    Alt+Shift+3 { move-window-to-workspace "3"; }
    Alt+Shift+4 { move-window-to-workspace "4"; }
    Alt+Shift+5 { move-window-to-workspace "5"; }
    Alt+Shift+Q { move-window-to-workspace "Q"; }
    Alt+Shift+W { move-window-to-workspace "W"; }
    Alt+Shift+E { move-window-to-workspace "E"; }
    Alt+Shift+R { move-window-to-workspace "R"; }

    Alt+Tab       { focus-workspace-previous; }   // 上一个工作区(往返)
    Alt+Shift+Tab { move-workspace-to-monitor-next; }

    // ── 截图(grim+slurp,脚本在 niri/scripts/)────
    Print      { spawn "bash" "-c" "$HOME/dotfiles/niri/scripts/screenshot.sh region"; }
    Shift+Print { spawn "bash" "-c" "$HOME/dotfiles/niri/scripts/screenshot.sh full"; }

    // ── 系统 ──────────────────────────────────────
    Alt+Shift+Escape { quit; }
    Alt+T        { spawn "bash" "-c" "$HOME/.config/nbshell/theme-next-sync"; }  // 切换主题并同步 nvim/Herdr
    Alt+Shift+T  { spawn "bash" "-c" "PATH=$HOME/.local/bin:$PATH nbshell wallpaper pick"; }  // nbshell 壁纸选择器
    Alt+Ctrl+T   { spawn "bash" "-c" "PATH=$HOME/.local/bin:$PATH nbshell dashboard"; }  // nbshell Dashboard
    Alt+Escape   { spawn "bash" "-c" "PATH=$HOME/.local/bin:$PATH nbshell power menu"; }  // nbshell 电源菜单
    Alt+N        { spawn "bash" "-c" "PATH=$HOME/.local/bin:$PATH nbshell notify center"; }  // nbshell 通知中心
    Alt+B        { spawn "bash" "-c" "PATH=$HOME/.local/bin:$PATH nbshell bar toggle"; }  // 仅切换 nbshell 状态栏显示/隐藏

    // ── 媒体键 ────────────────────────────────────
    XF86AudioRaiseVolume { spawn "bash" "-c" "PATH=$HOME/.local/bin:$PATH nbshell audio up"; }
    XF86AudioLowerVolume { spawn "bash" "-c" "PATH=$HOME/.local/bin:$PATH nbshell audio down"; }
    XF86AudioMute        { spawn "bash" "-c" "PATH=$HOME/.local/bin:$PATH nbshell audio mute"; }
    XF86AudioMicMute     { spawn "bash" "-c" "PATH=$HOME/.local/bin:$PATH nbshell audio micmute"; }
    XF86MonBrightnessUp   { spawn "bash" "-c" "PATH=$HOME/.local/bin:$PATH nbshell brightness up"; }
    XF86MonBrightnessDown { spawn "bash" "-c" "PATH=$HOME/.local/bin:$PATH nbshell brightness down"; }
    XF86AudioPlay         { spawn "bash" "-c" "PATH=$HOME/.local/bin:$PATH nbshell media playpause"; }
    XF86AudioNext         { spawn "bash" "-c" "PATH=$HOME/.local/bin:$PATH nbshell media next"; }
    XF86AudioPrev         { spawn "bash" "-c" "PATH=$HOME/.local/bin:$PATH nbshell media previous"; }
}

// ── 窗口圆角──────────────────────────────────────
// 轻微柔化应用窗口，同时保留紧凑、硬朗的 TUI 风格。
window-rule {
    geometry-corner-radius 4
    clip-to-geometry true
}
