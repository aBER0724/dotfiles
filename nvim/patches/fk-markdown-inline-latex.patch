+local body_scale_cache = {}
+
+local function kitty_font_family()
+    local config = vim.fn.expand('~/.config/kitty/kitty.conf')
+    local file = io.open(config, 'r')
+    if not file then
+        return 'monospace'
+    end
+    for line in file:lines() do
+        local family = line:match('^%s*font_family%s+(.+)%s*$')
+        if family then
+            file:close()
+            return family
+        end
+    end
+    file:close()
+    return 'monospace'
+end
+
+local function body_visual_scale(cell_h)
+    local family = kitty_font_family()
+    local key = ('%s:%d'):format(family, math.floor(cell_h + 0.5))
+    if body_scale_cache[key] then
+        return body_scale_cache[key]
+    end
+    local fallback = 0.45
+    if vim.fn.executable('fc-match') ~= 1 or vim.fn.executable('magick') ~= 1 then
+        body_scale_cache[key] = fallback
+        return fallback
+    end
+    local font = vim.system({ 'fc-match', '-f', '%{file}', family }, { text = true }):wait()
+    local font_path = font.stdout and vim.trim(font.stdout) or ''
+    if font.code ~= 0 or font_path == '' then
+        body_scale_cache[key] = fallback
+        return fallback
+    end
+    local sample_path = vim.fn.stdpath('cache')
+        .. '/fk_markdown/body-font-'
+        .. vim.fn.sha256(key):sub(1, 16)
+        .. '.png'
+    vim.fn.mkdir(vim.fn.fnamemodify(sample_path, ':h'), 'p')
+    local rendered = vim.system({
+        'magick',
+        '-background',
+        'none',
+        '-font',
+        font_path,
+        '-pointsize',
+        '100',
+        'label:nuv',
+        sample_path,
+    }):wait()
+    if rendered.code ~= 0 then
+        body_scale_cache[key] = fallback
+        return fallback
+    end
+    local canvas = vim.system({ 'magick', sample_path, '-format', '%h', 'info:' }, { text = true }):wait()
+    local ink = vim.system({
+        'magick',
+        sample_path,
+        '-trim',
+        '+repage',
+        '-format',
+        '%h',
+        'info:',
+    }, { text = true }):wait()
+    local canvas_h = tonumber(canvas.stdout)
+    local ink_h = tonumber(ink.stdout)
+    local scale = canvas_h and ink_h and canvas_h > 0 and (ink_h / canvas_h) or fallback
+    scale = math.max(0.35, math.min(0.75, scale))
+    body_scale_cache[key] = scale
+    return scale
+end
