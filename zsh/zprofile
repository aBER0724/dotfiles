# Homebrew shellenv — 平台自适应：只在 brew 实际存在的平台/路径上加载。
if [[ "$(uname -s)" == "Darwin" ]]; then
  # macOS: Apple Silicon (/opt/homebrew) 或 Intel (/usr/local)
  [ -x /opt/homebrew/bin/brew ] && eval "$(/opt/homebrew/bin/brew shellenv)"
  [ -x /usr/local/bin/brew ] && eval "$(/usr/local/bin/brew shellenv)"
elif [ -x /home/linuxbrew/.linuxbrew/bin/brew ]; then
  # Linux: 官方 Homebrew 路径
  eval "$(/home/linuxbrew/.linuxbrew/bin/brew shellenv)"
elif [ -x "$HOME/.linuxbrew/bin/brew" ]; then
  # Linux: ~/.linuxbrew(自编译安装)
  eval "$("$HOME/.linuxbrew/bin/brew" shellenv)"
fi

# Arch's autojump profile runs inside `emulate sh`, where assigning `fpath`
# updates only the exported FPATH scalar and can truncate it to two entries.
# Restore Zsh's core function directories after all /etc/profile snippets.
if [[ "$(uname -s)" == "Linux" ]]; then
  typeset -ga fpath
  fpath=(
    /usr/local/share/zsh/site-functions
    /usr/share/zsh/site-functions
    /usr/share/zsh/functions/*(N-/)
    /usr/share/zsh/functions/Completion/*(N-/)
    ${fpath:#/usr/share/zsh/functions/*}
  )
  typeset -gaU fpath
  export FPATH
fi

