export NVM_DIR="$HOME/.nvm"
# nvm — Homebrew (macOS) or the ~/.nvm standalone install.
[ -s "$HOME/.nvm/nvm.sh" ] && \. "$HOME/.nvm/nvm.sh"
[ -s "/opt/homebrew/opt/nvm/nvm.sh" ] && \. "/opt/homebrew/opt/nvm/nvm.sh"  # Homebrew nvm
[ -s "$HOME/.nvm/etc/bash_completion.d/nvm" ] && \. "$HOME/.nvm/etc/bash_completion.d/nvm"
[ -s "/opt/homebrew/opt/nvm/etc/bash_completion.d/nvm" ] && \. "/opt/homebrew/opt/nvm/etc/bash_completion.d/nvm"

# Homebrew (macOS, /opt/homebrew) — only prepend when the dir exists.
[ -d /opt/homebrew/bin ] && export PATH="/opt/homebrew/bin:$PATH"

# pipx-installed tools (platform-agnostic home).
export PATH="$PATH:$HOME/.local/bin"

[ ! -f "$HOME/.x-cmd.root/X" ] || . "$HOME/.x-cmd.root/X" # boot up x-cmd.

# thefuck — only when actually installed (not on every new machine by default).
if command -v thefuck >/dev/null 2>&1; then
  eval $(thefuck --alias)
  # You can use whatever you want as an alias, like for Mondays:
  eval $(thefuck --alias FUCK)
fi

# macOS-specific toolchains — only prepended when actually present.
[ -d /opt/homebrew/opt/libpq/bin ] && export PATH="/opt/homebrew/opt/libpq/bin:$PATH"

# Added by Antigravity
[ -d "$HOME/.antigravity/antigravity/bin" ] && export PATH="$HOME/.antigravity/antigravity/bin:$PATH"

# PIO
[ -d "$HOME/.platformio/penv/bin" ] && export PATH="$HOME/.platformio/penv/bin:$PATH"

# pnpm — macOS stores it under ~/Library; Linux may set its own.
if [ -d "$HOME/Library/pnpm" ]; then
  export PNPM_HOME="$HOME/Library/pnpm"
  case ":$PATH:" in
    *":$PNPM_HOME:"*) ;;
    *) export PATH="$PNPM_HOME:$PATH" ;;
  esac
fi
# pnpm end

