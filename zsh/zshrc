# Interactive Zsh configuration
# vim:fileencoding=utf-8:foldmethod=marker

# Startup ---------------------------------------------------------------------

# Disable iTerm2 prompt marks when its shell integration is present.
iterm2_prompt_mark() {
  :
}

MAILCHECK=0

# Greeting must run before the Powerlevel10k instant prompt.
() {
  local hour=$(date +%H)
  local greeting

  if (( hour >= 5 && hour < 12 )); then
    greeting='Good morning'
  elif (( hour >= 12 && hour < 18 )); then
    greeting='Good afternoon'
  elif (( hour >= 18 && hour < 22 )); then
    greeting='Good evening'
  else
    greeting='Burning midnight oil'
  fi

  print
  print "  $greeting, $USER. $(date '+%A, %B %-d')"
  print
}

# Keep this close to the top. Anything requiring user input must run above it.
if [[ -r "${XDG_CACHE_HOME:-$HOME/.cache}/p10k-instant-prompt-${(%):-%n}.zsh" ]]; then
  source "${XDG_CACHE_HOME:-$HOME/.cache}/p10k-instant-prompt-${(%):-%n}.zsh"
fi

# Oh My Zsh -------------------------------------------------------------------

export ZSH="$HOME/.oh-my-zsh"
export ZSH_CUSTOM="${ZSH_CUSTOM:-$ZSH/custom}"
ZSH_THEME='' # Powerlevel10k is loaded explicitly below.

plugins=(
  git
  docker
  kubectl
  npm
)

# Add zsh-completions to fpath before Oh My Zsh runs compinit.
for _zsh_cmp in \
  "$ZSH_CUSTOM/plugins/zsh-completions/src" \
  /opt/homebrew/share/zsh-completions \
  /usr/local/share/zsh-completions \
  /usr/share/zsh-completions
do
  [[ -d "$_zsh_cmp" ]] && { fpath=("$_zsh_cmp" $fpath); break; }
done
unset _zsh_cmp

if [[ -r "$ZSH/oh-my-zsh.sh" ]]; then
  source "$ZSH/oh-my-zsh.sh"
else
  print -u2 'dotfiles: Oh My Zsh is missing; run: bash ~/dotfiles/zsh/install-deps.sh'
fi

# Zsh plugins -----------------------------------------------------------------

# Load optional plugins from the first available platform-specific location.
for _zsh_auto in \
  "$ZSH_CUSTOM/plugins/zsh-autosuggestions/zsh-autosuggestions.zsh" \
  /opt/homebrew/share/zsh-autosuggestions/zsh-autosuggestions.zsh \
  /usr/local/share/zsh-autosuggestions/zsh-autosuggestions.zsh \
  /usr/share/zsh-autosuggestions/zsh-autosuggestions.zsh
do
  [[ -r "$_zsh_auto" ]] && { source "$_zsh_auto"; break; }
done
unset _zsh_auto

for _zsh_hl in \
  "$ZSH_CUSTOM/plugins/zsh-syntax-highlighting/zsh-syntax-highlighting.zsh" \
  /opt/homebrew/share/zsh-syntax-highlighting/zsh-syntax-highlighting.zsh \
  /usr/local/share/zsh-syntax-highlighting/zsh-syntax-highlighting.zsh \
  /usr/share/zsh-syntax-highlighting/zsh-syntax-highlighting.zsh
do
  [[ -r "$_zsh_hl" ]] && { source "$_zsh_hl"; break; }
done
unset _zsh_hl

for _zsh_z in \
  "$ZSH_CUSTOM/plugins/zsh-z/zsh-z.plugin.zsh" \
  /opt/homebrew/share/zsh-z/zsh-z.plugin.zsh \
  /usr/local/share/zsh-z/zsh-z.plugin.zsh \
  /usr/share/zsh-z/zsh-z.plugin.zsh
do
  [[ -r "$_zsh_z" ]] && { source "$_zsh_z"; break; }
done
unset _zsh_z

# Prompt ----------------------------------------------------------------------

for _p10k in \
  "$ZSH_CUSTOM/themes/powerlevel10k/powerlevel10k.zsh-theme" \
  "$HOME/powerlevel10k/powerlevel10k.zsh-theme" \
  /opt/homebrew/opt/powerlevel10k/powerlevel10k.zsh-theme
do
  [[ -r "$_p10k" ]] && { source "$_p10k"; break; }
done
unset _p10k

# Run `p10k configure` to regenerate this file.
[[ -r "$HOME/.p10k.zsh" ]] && source "$HOME/.p10k.zsh"

# PATH and toolchains ---------------------------------------------------------

# Keep the original ordering here: several installers prepend their own paths,
# so moving a block can change which version of a command wins.
[[ -d /usr/local/opt/curl/bin ]] && export PATH="/usr/local/opt/curl/bin:$PATH"

# nvm: standalone installation first, then Homebrew.
export NVM_DIR="$HOME/.nvm"
[[ -s "$HOME/.nvm/nvm.sh" ]] && source "$HOME/.nvm/nvm.sh"
[[ -s /opt/homebrew/opt/nvm/nvm.sh ]] && source /opt/homebrew/opt/nvm/nvm.sh
[[ -s "$HOME/.nvm/etc/bash_completion.d/nvm" ]] && source "$HOME/.nvm/etc/bash_completion.d/nvm"
[[ -s /opt/homebrew/opt/nvm/etc/bash_completion.d/nvm ]] && source /opt/homebrew/opt/nvm/etc/bash_completion.d/nvm

[[ -d /opt/homebrew/bin ]] && export PATH="/opt/homebrew/bin:$PATH"
export PATH="$PATH:$HOME/.local/bin"

# Optional macOS and user toolchains.
[[ -d /opt/homebrew/opt/libpq/bin ]] && export PATH="/opt/homebrew/opt/libpq/bin:$PATH"
[[ -d "$HOME/.antigravity/antigravity/bin" ]] && export PATH="$HOME/.antigravity/antigravity/bin:$PATH"
[[ -d "$HOME/.platformio/penv/bin" ]] && export PATH="$HOME/.platformio/penv/bin:$PATH"

# pnpm uses this location on macOS; Linux installations can provide their own.
if [[ -d "$HOME/Library/pnpm" ]]; then
  export PNPM_HOME="$HOME/Library/pnpm"
  case ":$PATH:" in
    *":$PNPM_HOME:"*) ;;
    *) export PATH="$PNPM_HOME:$PATH" ;;
  esac
fi

# Optional command integrations -----------------------------------------------

[[ ! -f "$HOME/.x-cmd.root/X" ]] || source "$HOME/.x-cmd.root/X"

if command -v thefuck >/dev/null 2>&1; then
  eval "$(thefuck --alias)"
  eval "$(thefuck --alias FUCK)"
fi

# Kaku shell and PATH integration.
[[ -r "$HOME/.config/kaku/zsh/kaku.zsh" ]] && source "$HOME/.config/kaku/zsh/kaku.zsh"
if [[ ":$PATH:" != *":$HOME/.config/kaku/zsh/bin:"* ]]; then
  export PATH="$HOME/.config/kaku/zsh/bin:$PATH"
fi

# Keep locally installed harness commands ahead of Kaku and system binaries.
export PATH="$HOME/.local/bin:$PATH"

# Linuxbrew fallback paths are intentionally loaded after the user paths above.
if [[ -x /home/linuxbrew/.linuxbrew/bin/brew ]]; then
  eval "$(/home/linuxbrew/.linuxbrew/bin/brew shellenv zsh)"
elif [[ -x "$HOME/.linuxbrew/bin/brew" ]]; then
  eval "$("$HOME/.linuxbrew/bin/brew" shellenv zsh)"
fi

# Otty enables this only for shells launched inside Otty.
if [[ -n "$OTTY_SHELL_INTEGRATION" && -r "$OTTY_SHELL_INTEGRATION/otty-integration.zsh" ]]; then
  source "$OTTY_SHELL_INTEGRATION/otty-integration.zsh"
fi

# Aliases ---------------------------------------------------------------------

# Editors
alias v='nvim'

# Terminal utilities
alias browser='terminal-browser'
unalias ff 2>/dev/null
ff() {
  if [[ -n "${SSH_CONNECTION:-}${SSH_CLIENT:-}${SSH_TTY:-}" ]]; then
    fastfetch --kitty "$HOME/.config/fastfetch/rx.png" --logo-width 30 --logo-padding-top 0 --logo-padding-left 1 --logo-padding-right 2 "$@"
  else
    fastfetch "$@"
  fi
}

# Input methods
alias rime-install='bash ~/plum/rime-install'

# Functions -------------------------------------------------------------------

# Use regular TUI mode over SSH to avoid fragmented mouse-reporting sequences
# leaking into Pi's editor. Local sessions keep the configured fullscreen mode.
pi() {
  if [[ -n "$SSH_CONNECTION" || -n "$SSH_TTY" ]]; then
    command pi --tui-mode regular "$@"
  else
    command pi "$@"
  fi
}

# Network
proxy_on() {
  export https_proxy='socks5://127.0.0.1:9870'
  export http_proxy='socks5://127.0.0.1:9870'
  export all_proxy='socks5://127.0.0.1:9870'
  print 'Proxy Enabled!'
}

proxy_off() {
  unset http_proxy https_proxy ftp_proxy
  print 'Proxy Disabled!'
}

# macOS applications
pdf() {
  open -a Skim "$@"
}

surge_activate() {
  bash "$HOME/Documents/Tool/Qurge-v6/StartQurge.command"
}

# Terminal recovery
# TUI programs can leave mouse reporting enabled after an abnormal exit.
_clear_mouse_mode() {
  printf '\033[?1000l\033[?1002l\033[?1003l\033[?1006l'
}

fixmouse() {
  _clear_mouse_mode
}

# Remote TUIs can leave additional mouse modes enabled in the local terminal.
ssh() {
  command ssh "$@"
  local rc=$?
  printf '\033[?1006l\033[?1016l\033[?1015l\033[?1005l\033[?1003l\033[?1002l\033[?1000l'
  return $rc
}

# Hooks -----------------------------------------------------------------------

# Clear mouse-reporting modes before each prompt after a TUI exits abnormally.
autoload -Uz add-zsh-hook
add-zsh-hook precmd _clear_mouse_mode
