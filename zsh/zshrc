# Terminal greeting — must be before p10k instant prompt to appear immediately
() {
  local hour=$(date +%H)
  local greeting
  if   (( hour >= 5  && hour < 12 )); then greeting="Good morning"
  elif (( hour >= 12 && hour < 18 )); then greeting="Good afternoon"
  elif (( hour >= 18 && hour < 22 )); then greeting="Good evening"
  else                                     greeting="Burning midnight oil"
  fi
  print ""
  print "  $greeting, $USER. $(date '+%A, %B %-d')"
  print ""
}

# Enable Powerlevel10k instant prompt. Should stay close to the top of ~/.zshrc.
# Initialization code that may require console input (password prompts, [y/n]
# confirmations, etc.) must go above this block; everything else may go below.
if [[ -r "${XDG_CACHE_HOME:-$HOME/.cache}/p10k-instant-prompt-${(%):-%n}.zsh" ]]; then
  source "${XDG_CACHE_HOME:-$HOME/.cache}/p10k-instant-prompt-${(%):-%n}.zsh"
fi

# If you come from bash you might have to change your $PATH.
# export PATH=$HOME/bin:$HOME/.local/bin:/usr/local/bin:$PATH

# Path to your Oh My Zsh installation.
export ZSH="$HOME/.oh-my-zsh"

# Set name of the theme to load --- if set to "random", it will
# load a random theme each time Oh My Zsh is loaded, in which case,
# to know which specific one was loaded, run: echo $RANDOM_THEME
# See https://github.com/ohmyzsh/ohmyzsh/wiki/Themes
ZSH_THEME=""  # theme loaded manually below via powerlevel10k

# Which plugins would you like to load?
# Standard plugins can be found in $ZSH/plugins/
# Custom plugins may be added to $ZSH_CUSTOM/plugins/
# Example format: plugins=(rails git textmate ruby lighthouse)
# Add wisely, as too many plugins slow down shell startup.
plugins=(
  git
  docker
  kubectl
  npm
)

# zsh-completions — add to fpath BEFORE oh-my-zsh runs compinit
# (same plugin Kaku bundles; loaded here so any terminal gets it).
for _zsh_cmp in \
  "$ZSH_CUSTOM/plugins/zsh-completions/src" \
  /opt/homebrew/share/zsh-completions \
  /usr/local/share/zsh-completions \
  /usr/share/zsh-completions
do
  [[ -d "$_zsh_cmp" ]] && { fpath=("$_zsh_cmp" $fpath); break; }
done
unset _zsh_cmp

if [[ -r "$ZSH/oh-my-zsh.sh" ]]; then
  source "$ZSH/oh-my-zsh.sh"
else
  print -u2 "dotfiles: Oh My Zsh is missing; run: bash ~/dotfiles/zsh/install-deps.sh"
fi

# zsh-autosuggestions — load from whichever platform location exists.
for _zsh_auto in \
  "$ZSH_CUSTOM/plugins/zsh-autosuggestions/zsh-autosuggestions.zsh" \
  /opt/homebrew/share/zsh-autosuggestions/zsh-autosuggestions.zsh \
  /usr/local/share/zsh-autosuggestions/zsh-autosuggestions.zsh \
  /usr/share/zsh-autosuggestions/zsh-autosuggestions.zsh
do
  [[ -r "$_zsh_auto" ]] && { source "$_zsh_auto"; break; }
done
unset _zsh_auto

# zsh-syntax-highlighting — load from whichever platform location exists.
for _zsh_hl in \
  "$ZSH_CUSTOM/plugins/zsh-syntax-highlighting/zsh-syntax-highlighting.zsh" \
  /opt/homebrew/share/zsh-syntax-highlighting/zsh-syntax-highlighting.zsh \
  /usr/local/share/zsh-syntax-highlighting/zsh-syntax-highlighting.zsh \
  /usr/share/zsh-syntax-highlighting/zsh-syntax-highlighting.zsh
do
  [[ -r "$_zsh_hl" ]] && { source "$_zsh_hl"; break; }
done
unset _zsh_hl

# zsh-z (smart directory jumping) — same plugin Kaku bundles.
for _zsh_z in \
  "$ZSH_CUSTOM/plugins/zsh-z/zsh-z.plugin.zsh" \
  /opt/homebrew/share/zsh-z/zsh-z.plugin.zsh \
  /usr/local/share/zsh-z/zsh-z.plugin.zsh \
  /usr/share/zsh-z/zsh-z.plugin.zsh
do
  [[ -r "$_zsh_z" ]] && { source "$_zsh_z"; break; }
done
unset _zsh_z


# Powerlevel10k — $ZSH_CUSTOM themes, ~/powerlevel10k clone, or Homebrew.
for _p10k in \
  "$ZSH_CUSTOM/themes/powerlevel10k/powerlevel10k.zsh-theme" \
  ~/powerlevel10k/powerlevel10k.zsh-theme \
  /opt/homebrew/opt/powerlevel10k/powerlevel10k.zsh-theme
do
  [[ -r "$_p10k" ]] && { source "$_p10k"; break; }
done
unset _p10k

# To customize prompt, run `p10k configure` or edit ~/.p10k.zsh.
[[ ! -f ~/.p10k.zsh ]] || source ~/.p10k.zsh

